new file mode 100644
index 0000000000000000000000000000000000000000..b7197093d90172c38e128a49bce1c3acb8dd248e
--- /dev/null
+++ b/src/main/resources/db/migration/V5__revise_notifications_for_inbox.sql
@@ -0,0 +1,130 @@
+-- 영구 DDL 전에 부분 적용 흔적과 새 알림함으로 분류할 수 없는 기존 payload를 확인한다.
+create temporary table notification_v5_preflight (
+    valid tinyint not null,
+    constraint chk_notification_v5_preflight check (valid = 1)
+);
+
+insert into notification_v5_preflight (valid)
+select case when
+    exists (
+        select 1
+        from information_schema.columns
+        where table_schema = database()
+          and table_name = 'notifications'
+          and column_name = 'client_app'
+    )
+    or exists (
+        select 1
+        from information_schema.statistics
+        where table_schema = database()
+          and table_name = 'notifications'
+          and index_name = 'idx_notifications_member_app_created_id'
+    )
+    or exists (
+        select 1
+        from information_schema.table_constraints
+        where constraint_schema = database()
+          and table_name = 'notifications'
+          and constraint_name = 'chk_notifications_inbox_payload'
+    )
+    or exists (
+        select 1
+        from notifications n
+        join members m on n.member_id = m.id
+        where n.type in (
+                  'MATCHING_OFFER_RECEIVED',
+                  'MATCHING_OFFER_CLOSED',
+                  'MATCHING_CONFIRMED'
+              )
+          and m.role in ('CONSUMER', 'INSTRUCTOR')
+          and (
+              (
+                  n.type in ('MATCHING_OFFER_RECEIVED', 'MATCHING_OFFER_CLOSED')
+                  and coalesce(
+                      json_unquote(json_extract(n.data_json, '$.matchingOfferId')) regexp '^[1-9][0-9]*$'
+                      and (
+                          char_length(json_unquote(json_extract(n.data_json, '$.matchingOfferId'))) < 19
+                          or (
+                              char_length(json_unquote(json_extract(n.data_json, '$.matchingOfferId'))) = 19
+                              and json_unquote(json_extract(n.data_json, '$.matchingOfferId'))
+                                  <= '9223372036854775807'
+                          )
+                      ),
+                      0
+                  ) = 0
+              )
+              or (
+                  n.type = 'MATCHING_CONFIRMED'
+                  and coalesce(
+                      json_unquote(json_extract(n.data_json, '$.lessonId')) regexp '^[1-9][0-9]*$'
+                      and (
+                          char_length(json_unquote(json_extract(n.data_json, '$.lessonId'))) < 19
+                          or (
+                              char_length(json_unquote(json_extract(n.data_json, '$.lessonId'))) = 19
+                              and json_unquote(json_extract(n.data_json, '$.lessonId'))
+                                  <= '9223372036854775807'
+                          )
+                      ),
+                      0
+                  ) = 0
+              )
+          )
+    )
+then 0 else 1 end;
+
+drop temporary table notification_v5_preflight;
+
+-- 한 번의 DDL로 nullable 분류 열, 구버전 형식용 발송 기본값, 조회 인덱스와 새 쓰기 제약을 함께 추가한다.
+-- V5 이후 구버전 writer가 만든 행은 미분류로 남으므로 배포 중 알림 동시 쓰기는 허용하지 않는다.
+alter table notifications
+    add column client_app enum ('CONSUMER','INSTRUCTOR') null after member_id,
+    modify column delivery_status enum ('FAILED','PENDING','SENT') not null default 'PENDING',
+    add constraint chk_notifications_inbox_payload check (
+        client_app is null
+        or (
+            type in ('MATCHING_OFFER_RECEIVED', 'MATCHING_OFFER_CLOSED')
+            and coalesce(
+                json_unquote(json_extract(data_json, '$.matchingOfferId')) regexp '^[1-9][0-9]*$'
+                and (
+                    char_length(json_unquote(json_extract(data_json, '$.matchingOfferId'))) < 19
+                    or (
+                        char_length(json_unquote(json_extract(data_json, '$.matchingOfferId'))) = 19
+                        and json_unquote(json_extract(data_json, '$.matchingOfferId'))
+                            <= '9223372036854775807'
+                    )
+                ),
+                0
+            ) = 1
+        )
+        or (
+            type = 'MATCHING_CONFIRMED'
+            and coalesce(
+                json_unquote(json_extract(data_json, '$.lessonId')) regexp '^[1-9][0-9]*$'
+                and (
+                    char_length(json_unquote(json_extract(data_json, '$.lessonId'))) < 19
+                    or (
+                        char_length(json_unquote(json_extract(data_json, '$.lessonId'))) = 19
+                        and json_unquote(json_extract(data_json, '$.lessonId'))
+                            <= '9223372036854775807'
+                    )
+                ),
+                0
+            ) = 1
+        )
+    ),
+    add index idx_notifications_member_app_created_id (member_id, client_app, created_at, id);
+
+-- 확정된 타입·역할·payload를 가진 기존 행만 새 알림함에 분류한다. 나머지 legacy 행은 보존한다.
+update notifications n
+    join members m on n.member_id = m.id
+set n.client_app = case
+    when m.role = 'INSTRUCTOR' then 'INSTRUCTOR'
+    when m.role = 'CONSUMER' then 'CONSUMER'
+end
+where n.client_app is null
+  and m.role in ('CONSUMER', 'INSTRUCTOR')
+  and n.type in (
+      'MATCHING_OFFER_RECEIVED',
+      'MATCHING_OFFER_CLOSED',
+      'MATCHING_CONFIRMED'
+  );
