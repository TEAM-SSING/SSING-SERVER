+package org.sopt.ssingserver.database;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import java.sql.Timestamp;
+import java.util.List;
+import org.flywaydb.core.Flyway;
+import org.flywaydb.core.api.FlywayException;
+import org.flywaydb.core.api.MigrationVersion;
+import org.flywaydb.core.api.configuration.FluentConfiguration;
+import org.junit.jupiter.api.AfterAll;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.dao.DataAccessException;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.jdbc.datasource.DriverManagerDataSource;
+import org.testcontainers.mysql.MySQLContainer;
+import org.testcontainers.utility.DockerImageName;
+
+class NotificationV5MigrationTest {
+
+    private static final MySQLContainer MYSQL = new MySQLContainer(DockerImageName.parse("mysql:8.4.8"))
+            .withDatabaseName("ssing_notification_migration")
+            .withUsername("ssing")
+            .withPassword("ssing")
+            .withCommand("--log-bin-trust-function-creators=1");
+
+    private static final JdbcTemplate JDBC_TEMPLATE;
+
+    static {
+        MYSQL.start();
+        JDBC_TEMPLATE = new JdbcTemplate(new DriverManagerDataSource(
+                MYSQL.getJdbcUrl(),
+                MYSQL.getUsername(),
+                MYSQL.getPassword()
+        ));
+    }
+
+    @BeforeEach
+    void migrateToV4AndInsertMembers() {
+        flyway().clean();
+        flyway(MigrationVersion.fromVersion("4")).migrate();
+        insertMember(1L, "CONSUMER");
+        insertMember(2L, "INSTRUCTOR");
+        insertMember(3L, "ADMIN");
+    }
+
+    @AfterAll
+    static void stopMysql() {
+        MYSQL.stop();
+    }
+
+    @Test
+    void V4_알림을_보존하며_V5_호환_스키마와_앱_구분값을_적용한다() {
+        insertNotification(
+                1L,
+                1L,
+                "MATCHING_OFFER_RECEIVED",
+                "{\"matchingOfferId\":10}",
+                "SENT",
+                "2026-07-14 10:01:00.000000"
+        );
+        insertNotification(
+                2L,
+                2L,
+                "MATCHING_CONFIRMED",
+                "{\"lessonId\":\"15\"}",
+                "FAILED",
+                null
+        );
+        List<NotificationSnapshot> beforeMigration = notificationSnapshots();
+
+        Flyway latestFlyway = flyway();
+        latestFlyway.migrate();
+        latestFlyway.validate();
+
+        assertThat(notificationSnapshots()).containsExactlyElementsOf(beforeMigration);
+        assertThat(JDBC_TEMPLATE.queryForList(
+                "SELECT client_app FROM notifications ORDER BY id",
+                String.class
+        )).containsExactly("CONSUMER", "INSTRUCTOR");
+        assertThat(columnDataType("type")).isEqualTo("varchar");
+        assertThat(columnIsNullable("client_app")).isEqualTo("YES");
+        assertThat(columnCount("delivery_status")).isOne();
+        assertThat(columnCount("sent_at")).isOne();
+        assertThat(columnDefault("delivery_status")).isEqualTo("PENDING");
+        assertThat(constraintCount("chk_notifications_inbox_payload")).isOne();
+        assertThat(indexColumns("idx_notifications_member_app_created_id"))
+                .isEqualTo("member_id,client_app,created_at,id");
+        assertThat(successfulV5HistoryCount()).isOne();
+        assertThat(latestFlyway.migrate().migrationsExecuted).isZero();
+
+        JDBC_TEMPLATE.update(
+                """
+                INSERT INTO notifications (
+                    member_id, client_app, type, title, body, data_json, created_at, updated_at
+                ) VALUES (?, 'CONSUMER', 'MATCHING_OFFER_CLOSED', '제목', '본문',
+                          JSON_OBJECT('matchingOfferId', 20), UTC_TIMESTAMP(6), UTC_TIMESTAMP(6))
+                """,
+                1L
+        );
+        assertThat(JDBC_TEMPLATE.queryForObject(
+                "SELECT delivery_status FROM notifications WHERE id = 3",
+                String.class
+        )).isEqualTo("PENDING");
+
+        insertNotification(
+                4L,
+                1L,
+                "MATCHING_OFFER_CLOSED",
+                "{\"matchingOfferId\":20}",
+                "SENT",
+                null
+        );
+        assertThat(JDBC_TEMPLATE.queryForObject(
+                "SELECT client_app FROM notifications WHERE id = 4",
+                String.class
+        )).isNull();
+        assertThat(JDBC_TEMPLATE.queryForObject(
+                "SELECT type FROM notifications WHERE id = 4",
+                String.class
+        )).isEqualTo("MATCHING_OFFER_CLOSED");
+
+        assertThatThrownBy(() -> JDBC_TEMPLATE.update(
+                """
+                INSERT INTO notifications (
+                    member_id, client_app, type, title, body, data_json, created_at, updated_at
+                ) VALUES (?, 'CONSUMER', 'MATCHING_OFFER_RECEIVED', '잘못된 제목', '잘못된 본문',
+                          JSON_OBJECT(), UTC_TIMESTAMP(6), UTC_TIMESTAMP(6))
+                """,
+                1L
+        )).isInstanceOf(DataAccessException.class);
+    }
+
+    @Test
+    void 지원하지_않는_type과_ADMIN_알림은_보존하되_새_알림함에는_분류하지_않는다() {
+        insertNotification(
+                1L,
+                1L,
+                "LEGACY_PROMOTION",
+                "{}",
+                "SENT",
+                null
+        );
+        insertNotification(
+                2L,
+                3L,
+                "MATCHING_OFFER_RECEIVED",
+                "{\"matchingOfferId\":10}",
+                "PENDING",
+                null
+        );
+        List<NotificationSnapshot> beforeMigration = notificationSnapshots();
+
+        Flyway latestFlyway = flyway();
+        latestFlyway.migrate();
+        latestFlyway.validate();
+
+        assertThat(notificationSnapshots()).containsExactlyElementsOf(beforeMigration);
+        assertThat(JDBC_TEMPLATE.query(
+                "SELECT client_app FROM notifications ORDER BY id",
+                (resultSet, rowNumber) -> resultSet.getString("client_app")
+        )).containsExactly(null, null);
+        assertThat(columnCount("client_app")).isOne();
+        assertThat(columnDataType("type")).isEqualTo("varchar");
+        assertThat(columnCount("delivery_status")).isOne();
+        assertThat(columnCount("sent_at")).isOne();
+        assertThat(successfulV5HistoryCount()).isOne();
+    }
+
+    @Test
+    void 필수_리소스_ID가_없는_기존_payload면_영구_DDL_전에_V5가_실패한다() {
+        insertNotification(
+                1L,
+                2L,
+                "MATCHING_CONFIRMED",
+                "{}",
+                "PENDING",
+                null
+        );
+
+        assertThatThrownBy(() -> flyway().migrate())
+                .isInstanceOf(FlywayException.class);
+
+        assertThat(columnCount("client_app")).isZero();
+        assertThat(columnDataType("type")).isEqualTo("varchar");
+        assertThat(successfulV5HistoryCount()).isZero();
+    }
+
+    @Test
+    void Long_범위를_넘는_기존_리소스_ID면_영구_DDL_전에_V5가_실패한다() {
+        insertNotification(
+                1L,
+                2L,
+                "MATCHING_CONFIRMED",
+                "{\"lessonId\":\"9223372036854775808\"}",
+                "PENDING",
+                null
+        );
+
+        assertThatThrownBy(() -> flyway().migrate())
+                .isInstanceOf(FlywayException.class);
+
+        assertThat(columnCount("client_app")).isZero();
+        assertThat(columnDataType("type")).isEqualTo("varchar");
+        assertThat(successfulV5HistoryCount()).isZero();
+    }
+
+    @Test
+    void 예약한_인덱스_이름이_이미_있으면_다른_영구_DDL_전에_V5가_실패한다() {
+        JDBC_TEMPLATE.execute(
+                "CREATE INDEX idx_notifications_member_app_created_id ON notifications (member_id)"
+        );
+
+        assertThatThrownBy(() -> flyway().migrate())
+                .isInstanceOf(FlywayException.class);
+
+        assertThat(columnCount("client_app")).isZero();
+        assertThat(columnDataType("type")).isEqualTo("varchar");
+        assertThat(columnDefault("delivery_status")).isNull();
+        assertThat(indexColumns("idx_notifications_member_app_created_id")).isEqualTo("member_id");
+        assertThat(successfulV5HistoryCount()).isZero();
+    }
+
+    @Test
+    void V5_DDL_직후_외부장애가_발생해도_안전한_상태에서_복구하고_재적용한다() {
+        insertNotification(
+                1L,
+                1L,
+                "MATCHING_OFFER_RECEIVED",
+                "{\"matchingOfferId\":10}",
+                "PENDING",
+                null
+        );
+        JDBC_TEMPLATE.execute(
+                """
+                CREATE TRIGGER block_notification_v5_backfill
+                BEFORE UPDATE ON notifications
+                FOR EACH ROW
+                SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'simulated backfill failure'
+                """
+        );
+
+        assertThatThrownBy(() -> flyway().migrate())
+                .isInstanceOf(FlywayException.class);
+
+        assertThat(columnCount("client_app")).isOne();
+        assertThat(columnIsNullable("client_app")).isEqualTo("YES");
+        assertThat(JDBC_TEMPLATE.queryForObject(
+                "SELECT client_app FROM notifications WHERE id = 1",
+                String.class
+        )).isNull();
+        assertThat(columnDefault("delivery_status")).isEqualTo("PENDING");
+        assertThat(constraintCount("chk_notifications_inbox_payload")).isOne();
+        assertThat(indexColumns("idx_notifications_member_app_created_id"))
+                .isEqualTo("member_id,client_app,created_at,id");
+        assertThat(successfulV5HistoryCount()).isZero();
+
+        JDBC_TEMPLATE.execute("DROP TRIGGER block_notification_v5_backfill");
+        JDBC_TEMPLATE.execute(
+                """
+                ALTER TABLE notifications
+                    ADD INDEX idx_notifications_member_recovery (member_id),
+                    DROP INDEX idx_notifications_member_app_created_id,
+                    DROP CHECK chk_notifications_inbox_payload,
+                    MODIFY COLUMN delivery_status enum ('FAILED','PENDING','SENT') NOT NULL,
+                    DROP COLUMN client_app
+                """
+        );
+
+        Flyway recoveredFlyway = flyway();
+        recoveredFlyway.repair();
+        recoveredFlyway.migrate();
+        recoveredFlyway.validate();
+        JDBC_TEMPLATE.execute("ALTER TABLE notifications DROP INDEX idx_notifications_member_recovery");
+
+        assertThat(JDBC_TEMPLATE.queryForObject(
+                "SELECT client_app FROM notifications WHERE id = 1",
+                String.class
+        )).isEqualTo("CONSUMER");
+        assertThat(successfulV5HistoryCount()).isOne();
+    }
+
+    private static Flyway flyway(MigrationVersion... targetVersion) {
+        FluentConfiguration configuration = Flyway.configure()
+                .dataSource(MYSQL.getJdbcUrl(), MYSQL.getUsername(), MYSQL.getPassword())
+                .locations("classpath:db/migration")
+                .validateMigrationNaming(true)
+                .failOnMissingLocations(true)
+                .validateOnMigrate(true)
+                .baselineOnMigrate(false)
+                .cleanDisabled(false);
+        if (targetVersion.length == 1) {
+            configuration.target(targetVersion[0]);
+        }
+        return configuration.load();
+    }
+
+    private static void insertMember(long id, String role) {
+        JDBC_TEMPLATE.update(
+                """
+                INSERT INTO members (
+                    id, nickname, profile_image_url, role, status, created_at, updated_at
+                ) VALUES (?, ?, NULL, ?, 'ACTIVE', UTC_TIMESTAMP(6), UTC_TIMESTAMP(6))
+                """,
+                id,
+                "마이그레이션회원" + id,
+                role
+        );
+    }
+
+    private static void insertNotification(
+            long id,
+            long memberId,
+            String type,
+            String dataJson,
+            String deliveryStatus,
+            String sentAt
+    ) {
+        JDBC_TEMPLATE.update(
+                """
+                INSERT INTO notifications (
+                    id, member_id, type, title, body, data_json, delivery_status,
+                    sent_at, read_at, created_at, updated_at
+                ) VALUES (?, ?, ?, '기존 제목', '기존 본문', ?, ?, ?, NULL,
+                          '2026-07-14 10:00:00.000000', '2026-07-14 10:00:00.000000')
+                """,
+                id,
+                memberId,
+                type,
+                dataJson,
+                deliveryStatus,
+                sentAt
+        );
+    }
+
+    private static List<NotificationSnapshot> notificationSnapshots() {
+        return JDBC_TEMPLATE.query(
+                """
+                SELECT id, member_id, type, title, body, data_json, delivery_status,
+                       sent_at, read_at, created_at, updated_at
+                FROM notifications
+                ORDER BY id
+                """,
+                (resultSet, rowNumber) -> new NotificationSnapshot(
+                        resultSet.getLong("id"),
+                        resultSet.getLong("member_id"),
+                        resultSet.getString("type"),
+                        resultSet.getString("title"),
+                        resultSet.getString("body"),
+                        resultSet.getString("data_json"),
+                        resultSet.getString("delivery_status"),
+                        resultSet.getTimestamp("sent_at"),
+                        resultSet.getTimestamp("read_at"),
+                        resultSet.getTimestamp("created_at"),
+                        resultSet.getTimestamp("updated_at")
+                )
+        );
+    }
+
+    private static int columnCount(String columnName) {
+        return JDBC_TEMPLATE.queryForObject(
+                """
+                SELECT COUNT(*)
+                FROM information_schema.columns
+                WHERE table_schema = DATABASE()
+                  AND table_name = 'notifications'
+                  AND column_name = ?
+                """,
+                Integer.class,
+                columnName
+        );
+    }
+
+    private static String columnDataType(String columnName) {
+        return JDBC_TEMPLATE.queryForObject(
+                """
+                SELECT data_type
+                FROM information_schema.columns
+                WHERE table_schema = DATABASE()
+                  AND table_name = 'notifications'
+                  AND column_name = ?
+                """,
+                String.class,
+                columnName
+        );
+    }
+
+    private static String columnDefault(String columnName) {
+        return JDBC_TEMPLATE.queryForObject(
+                """
+                SELECT column_default
+                FROM information_schema.columns
+                WHERE table_schema = DATABASE()
+                  AND table_name = 'notifications'
+                  AND column_name = ?
+                """,
+                String.class,
+                columnName
+        );
+    }
+
+    private static String columnIsNullable(String columnName) {
+        return JDBC_TEMPLATE.queryForObject(
+                """
+                SELECT is_nullable
+                FROM information_schema.columns
+                WHERE table_schema = DATABASE()
+                  AND table_name = 'notifications'
+                  AND column_name = ?
+                """,
+                String.class,
+                columnName
+        );
+    }
+
+    private static int constraintCount(String constraintName) {
+        return JDBC_TEMPLATE.queryForObject(
+                """
+                SELECT COUNT(*)
+                FROM information_schema.table_constraints
+                WHERE constraint_schema = DATABASE()
+                  AND table_name = 'notifications'
+                  AND constraint_name = ?
+                """,
+                Integer.class,
+                constraintName
+        );
+    }
+
+    private static String indexColumns(String indexName) {
+        return JDBC_TEMPLATE.queryForObject(
+                """
+                SELECT GROUP_CONCAT(column_name ORDER BY seq_in_index SEPARATOR ',')
+                FROM information_schema.statistics
+                WHERE table_schema = DATABASE()
+                  AND table_name = 'notifications'
+                  AND index_name = ?
+                """,
+                String.class,
+                indexName
+        );
+    }
+
+    private static int successfulV5HistoryCount() {
+        return JDBC_TEMPLATE.queryForObject(
+                """
+                SELECT COUNT(*)
+                FROM flyway_schema_history
+                WHERE version = '5'
+                  AND success = 1
+                """,
+                Integer.class
+        );
+    }
+
+    private record NotificationSnapshot(
+            long id,
+            long memberId,
+            String type,
+            String title,
+            String body,
+            String dataJson,
+            String deliveryStatus,
+            Timestamp sentAt,
+            Timestamp readAt,
+            Timestamp createdAt,
+            Timestamp updatedAt
+    ) {
+    }
+}
