+package org.sopt.ssingserver.global.realtime;
+
+import java.util.Map;
+import java.util.Set;
+import java.util.function.Function;
+import java.util.stream.Collectors;
+import java.util.stream.StreamSupport;
+import lombok.RequiredArgsConstructor;
+import org.sopt.ssingserver.domain.member.enums.MemberRole;
+import org.sopt.ssingserver.domain.member.enums.MemberStatus;
+import org.sopt.ssingserver.domain.member.repository.MemberRepository;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+@Service
+@RequiredArgsConstructor
+class RealtimeMemberAuthorizationReader {
+
+    private final MemberRepository memberRepository;
+
+    @Transactional(readOnly = true)
+    public Map<Long, MemberAuthorizationSnapshot> findAll(Set<Long> memberIds) {
+        if (memberIds.isEmpty()) {
+            return Map.of();
+        }
+        return StreamSupport.stream(memberRepository.findAllById(memberIds).spliterator(), false)
+                .map(member -> new MemberAuthorizationSnapshot(
+                        member.getId(),
+                        member.getRole(),
+                        member.getStatus()
+                ))
+                .collect(Collectors.toUnmodifiableMap(
+                        MemberAuthorizationSnapshot::memberId,
+                        Function.identity()
+                ));
+    }
+
+    record MemberAuthorizationSnapshot(
+            Long memberId,
+            MemberRole role,
+            MemberStatus status
+    ) {
+    }
+}
