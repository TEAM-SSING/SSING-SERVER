+package org.sopt.ssingserver.domain.lesson.service;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import ch.qos.logback.classic.Logger;
+import ch.qos.logback.classic.spi.ILoggingEvent;
+import ch.qos.logback.core.read.ListAppender;
+import java.util.Map;
+import java.util.stream.Collectors;
+import org.junit.jupiter.api.Test;
+import org.slf4j.LoggerFactory;
+import org.springframework.transaction.support.TransactionSynchronization;
+import org.springframework.transaction.support.TransactionSynchronizationManager;
+
+class LessonAfterCommitExecutorTest {
+
+    @Test
+    void execute는_커밋후_실패로그에_예외메시지와_payload를_남기지_않는다() {
+        LessonAfterCommitExecutor executor = new LessonAfterCommitExecutor();
+        Logger logger = (Logger) LoggerFactory.getLogger(LessonAfterCommitExecutor.class);
+        ListAppender<ILoggingEvent> appender = new ListAppender<>();
+        appender.start();
+        logger.addAppender(appender);
+        TransactionSynchronizationManager.initSynchronization();
+
+        try {
+            executor.execute("lesson-realtime-publish", () -> {
+                throw new IllegalStateException(
+                        "private-lesson-payload",
+                        new IllegalArgumentException("Bearer secret-token")
+                );
+            });
+            TransactionSynchronizationManager.getSynchronizations()
+                    .forEach(TransactionSynchronization::afterCommit);
+
+            ILoggingEvent event = appender.list.getFirst();
+            assertThat(event.getThrowableProxy()).isNull();
+            assertThat(keyValueMap(event))
+                    .containsEntry("event", "lesson.after_commit.failed")
+                    .containsEntry("task", "lesson-realtime-publish")
+                    .containsEntry("exception_type", IllegalStateException.class.getName())
+                    .containsEntry("root_cause_type", IllegalArgumentException.class.getName());
+            assertThat(event.toString())
+                    .doesNotContain("private-lesson-payload", "Bearer secret-token");
+        } finally {
+            TransactionSynchronizationManager.clearSynchronization();
+            logger.detachAppender(appender);
+        }
+    }
+
+    private Map<String, Object> keyValueMap(ILoggingEvent event) {
+        return event.getKeyValuePairs().stream()
+                .collect(Collectors.toMap(keyValuePair -> keyValuePair.key, keyValuePair -> keyValuePair.value));
+    }
+}
