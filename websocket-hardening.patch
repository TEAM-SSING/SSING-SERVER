+++ b/src/test/java/org/sopt/ssingserver/domain/lesson/dto/realtime/LessonRealtimeEventJsonTest.java
@@ -0,0 +1,156 @@
+package org.sopt.ssingserver.domain.lesson.dto.realtime;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.time.OffsetDateTime;
+import java.util.Map;
+import java.util.Set;
+import java.util.UUID;
+import java.util.stream.Collectors;
+import java.util.stream.Stream;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.MethodSource;
+import org.sopt.ssingserver.domain.lesson.dto.realtime.LessonRealtimeEvent.StartConfirmationUpdatedPayload;
+import org.sopt.ssingserver.domain.lesson.enums.LessonStatus;
+import tools.jackson.databind.JsonNode;
+import tools.jackson.databind.ObjectMapper;
+
+class LessonRealtimeEventJsonTest {
+
+    private static final UUID EVENT_ID = UUID.fromString("4a154ce9-0a1f-4af1-a520-f7907ba70001");
+    private static final OffsetDateTime OCCURRED_AT = OffsetDateTime.parse("2026-07-07T10:00:00+09:00");
+    private static final String OCCURRED_AT_JSON = "2026-07-07T10:00:00+09:00";
+    private static final Set<String> TOP_LEVEL_FIELDS = Set.of(
+            "eventId", "eventType", "occurredAt", "recipientRole", "lessonId", "lessonStatus", "payload"
+    );
+
+    private final ObjectMapper objectMapper = new ObjectMapper();
+
+    @Test
+    void 강습_WebSocket_event_type과_JSON_case_목록은_계약과_동일하다() {
+        assertThat(LessonRealtimeEventType.values())
+                .extracting(LessonRealtimeEventType::name)
+                .containsExactlyInAnyOrder(
+                        "LESSON_START_CONFIRMATION_UPDATED",
+                        "LESSON_STARTED",
+                        "LESSON_COMPLETED",
+                        "LESSON_CANCELED"
+                );
+        assertThat(lessonEventCases().map(contract -> contract.event().eventType()))
+                .containsExactlyInAnyOrder(LessonRealtimeEventType.values());
+    }
+
+    @ParameterizedTest(name = "{0}")
+    @MethodSource("lessonEventCases")
+    void 강습_WebSocket_event별_envelope과_payload_JSON_계약을_직렬화한다(LessonJsonContract contract) {
+        LessonRealtimeEvent event = contract.event();
+        JsonNode root = objectMapper.valueToTree(event);
+        JsonNode payload = root.path("payload");
+
+        assertThat(fieldNames(root)).containsExactlyInAnyOrderElementsOf(TOP_LEVEL_FIELDS);
+        assertThat(root.path("eventId").asString()).isEqualTo(event.eventId().toString());
+        assertThat(root.path("eventType").asString()).isEqualTo(event.eventType().name());
+        assertThat(root.path("occurredAt").asString()).isEqualTo(OCCURRED_AT_JSON);
+        assertThat(root.path("recipientRole").asString()).isEqualTo(event.recipientRole().name());
+        assertThat(root.path("lessonId").asLong()).isEqualTo(event.lessonId());
+        assertThat(root.path("lessonStatus").asString()).isEqualTo(event.lessonStatus().name());
+        assertThat(payload.isObject()).isTrue();
+        assertThat(fieldNames(payload)).containsExactlyInAnyOrderElementsOf(contract.payloadFields());
+        assertThat(root.has("success")).isFalse();
+        assertThat(root.has("data")).isFalse();
+        assertThat(root.has("requestId")).isFalse();
+
+        if (event.eventType() == LessonRealtimeEventType.LESSON_START_CONFIRMATION_UPDATED) {
+            assertThat(payload.path("confirmedCount").asInt()).isEqualTo(2);
+            assertThat(payload.path("requiredCount").asInt()).isEqualTo(3);
+            assertThat(payload.path("currentActorConfirmed").asBoolean()).isTrue();
+            assertThat(payload.path("instructorConfirmed").asBoolean()).isFalse();
+        } else {
+            assertThat(payload.size()).isZero();
+        }
+    }
+
+    private static Stream<LessonJsonContract> lessonEventCases() {
+        return Stream.of(
+                new LessonJsonContract(
+                        "LESSON_START_CONFIRMATION_UPDATED",
+                        event(
+                                LessonRealtimeEventType.LESSON_START_CONFIRMATION_UPDATED,
+                                LessonRealtimeRecipientRole.CONSUMER,
+                                LessonStatus.CONFIRMED,
+                                new StartConfirmationUpdatedPayload(2, 3, true, false)
+                        ),
+                        Set.of(
+                                "confirmedCount", "requiredCount",
+                                "currentActorConfirmed", "instructorConfirmed"
+                        )
+                ),
+                new LessonJsonContract(
+                        "LESSON_STARTED",
+                        event(
+                                LessonRealtimeEventType.LESSON_STARTED,
+                                LessonRealtimeRecipientRole.INSTRUCTOR,
+                                LessonStatus.IN_PROGRESS,
+                                Map.of()
+                        ),
+                        Set.of()
+                ),
+                new LessonJsonContract(
+                        "LESSON_COMPLETED",
+                        event(
+                                LessonRealtimeEventType.LESSON_COMPLETED,
+                                LessonRealtimeRecipientRole.CONSUMER,
+                                LessonStatus.COMPLETED,
+                                Map.of()
+                        ),
+                        Set.of()
+                ),
+                new LessonJsonContract(
+                        "LESSON_CANCELED",
+                        event(
+                                LessonRealtimeEventType.LESSON_CANCELED,
+                                LessonRealtimeRecipientRole.INSTRUCTOR,
+                                LessonStatus.CANCELED,
+                                Map.of()
+                        ),
+                        Set.of()
+                )
+        );
+    }
+
+    private static LessonRealtimeEvent event(
+            LessonRealtimeEventType eventType,
+            LessonRealtimeRecipientRole recipientRole,
+            LessonStatus lessonStatus,
+            Object payload
+    ) {
+        return new LessonRealtimeEvent(
+                EVENT_ID,
+                eventType,
+                OCCURRED_AT,
+                recipientRole,
+                60L,
+                lessonStatus,
+                payload
+        );
+    }
+
+    private Set<String> fieldNames(JsonNode node) {
+        return node.properties().stream()
+                .map(Map.Entry::getKey)
+                .collect(Collectors.toSet());
+    }
+
+    private record LessonJsonContract(
+            String name,
+            LessonRealtimeEvent event,
+            Set<String> payloadFields
+    ) {
+
+        @Override
+        public String toString() {
+            return name;
+        }
+    }
+}
