+            ).gauge().value()).isEqualTo(1);
+
+            boolean disconnected = fixture.subscriptionLimiter().clearSession("raw-session-id");
+            fixture.observability().disconnected("raw-session-id", CloseStatus.NORMAL, disconnected);
+            fixture.observability().disconnected("raw-session-id", CloseStatus.NORMAL, false);
