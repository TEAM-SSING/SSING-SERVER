+package org.sopt.ssingserver.global.realtime;
+
+import io.micrometer.core.instrument.Counter;
+import io.micrometer.core.instrument.Gauge;
+import io.micrometer.core.instrument.MeterRegistry;
+import io.micrometer.core.instrument.Timer;
+import java.nio.charset.StandardCharsets;
+import java.security.GeneralSecurityException;
+import java.security.SecureRandom;
+import java.time.Duration;
+import java.util.HexFormat;
+import java.util.UUID;
+import javax.crypto.Mac;
+import javax.crypto.spec.SecretKeySpec;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.slf4j.spi.LoggingEventBuilder;
+import org.sopt.ssingserver.domain.auth.token.AccessTokenException;
+import org.sopt.ssingserver.global.error.BusinessException;
+import org.sopt.ssingserver.global.error.CommonErrorCode;
+import org.sopt.ssingserver.global.error.ErrorCode;
+import org.springframework.beans.factory.annotation.Qualifier;
+import org.springframework.messaging.simp.stomp.StompCommand;
+import org.springframework.scheduling.annotation.Scheduled;
+import org.springframework.scheduling.concurrent.ThreadPoolTaskExecutor;
+import org.springframework.security.access.AccessDeniedException;
+import org.springframework.stereotype.Component;
+import org.springframework.web.socket.CloseStatus;
+
+@Component
+public class RealtimeWebSocketObservability {
+
+    private static final Logger log = LoggerFactory.getLogger(RealtimeWebSocketObservability.class);
+    private static final String HMAC_ALGORITHM = "HmacSHA256";
+    private static final int SESSION_HASH_BYTES = 8;
+
+    private final MeterRegistry meterRegistry;
+    private final RealtimeWebSocketProperties properties;
+    private final ThreadPoolTaskExecutor inboundExecutor;
+    private final ThreadPoolTaskExecutor outboundExecutor;
+    private final RealtimeStompSubscriptionLimiter subscriptionLimiter;
+    private final byte[] sessionHashKey;
+
+    public RealtimeWebSocketObservability(
+            MeterRegistry meterRegistry,
+            RealtimeWebSocketProperties properties,
+            @Qualifier(RealtimeWebSocketExecutorConfig.INBOUND_EXECUTOR_BEAN)
+            ThreadPoolTaskExecutor inboundExecutor,
+            @Qualifier(RealtimeWebSocketExecutorConfig.OUTBOUND_EXECUTOR_BEAN)
+            ThreadPoolTaskExecutor outboundExecutor,
+            RealtimeStompSubscriptionLimiter subscriptionLimiter
+    ) {
+        this.meterRegistry = meterRegistry;
+        this.properties = properties;
+        this.inboundExecutor = inboundExecutor;
+        this.outboundExecutor = outboundExecutor;
+        this.subscriptionLimiter = subscriptionLimiter;
+        this.sessionHashKey = new byte[32];
+        new SecureRandom().nextBytes(this.sessionHashKey);
+        registerGauges();
+    }
+
+    public void connected(
+            String sessionId,
+            boolean connected
+    ) {
+        if (connected) {
+            commandCounter("CONNECT", "accepted", "NONE", "none").increment();
+        }
+        log.atInfo()
+                .addKeyValue("event", "realtime.stomp.session.connected")
+                .addKeyValue("instance_id", properties.instanceId())
+                .addKeyValue("session_id", safeSessionId(sessionId))
+                .addKeyValue("command", "CONNECT")
+                .addKeyValue("outcome", connected ? "accepted" : "ignored_invalid_transition")
+                .log("Realtime STOMP session connected");
+    }
+
+    public void disconnected(
+            String sessionId,
+            CloseStatus closeStatus,
+            boolean disconnected
+    ) {
+        if (disconnected) {
+            meterRegistry.counter(
+                    "ssing.realtime.stomp.disconnects",
+                    "close_status", normalizeCloseStatus(closeStatus),
+                    "instance_id", properties.instanceId()
+            ).increment();
+        }
+        log.atInfo()
+                .addKeyValue("event", "realtime.stomp.session.disconnected")
+                .addKeyValue("instance_id", properties.instanceId())
+                .addKeyValue("session_id", safeSessionId(sessionId))
+                .addKeyValue("command", "DISCONNECT")
+                .addKeyValue("close_status", normalizeCloseStatus(closeStatus))
+                .addKeyValue("outcome", disconnected ? "closed" : "duplicate_or_pre_connected")
+                .log("Realtime STOMP session disconnected");
+    }
+
+    public void authorizationTerminationRequested(RealtimeWebSocketTerminationReason reason) {
+        meterRegistry.counter(
+                "ssing.realtime.authorization.termination.requests",
+                "reason", reason.metricValue(),
+                "instance_id", properties.instanceId()
+        ).increment();
+        log.atInfo()
+                .addKeyValue("event", "realtime.authorization.termination.requested")
+                .addKeyValue("instance_id", properties.instanceId())
+                .addKeyValue("reason", reason.metricValue())
+                .addKeyValue("close_code", reason.closeStatus().getCode())
+                .addKeyValue("outcome", "requested")
+                .log("Realtime WebSocket authorization termination requested");
+    }
+
+    public void authorizationTerminationFailed(
+            RealtimeWebSocketTerminationReason reason,
+            Throwable exception
+    ) {
+        meterRegistry.counter(
+                "ssing.realtime.authorization.termination.failures",
+                "reason", reason.metricValue(),
+                "failure_stage", "transport-close",
+                "instance_id", properties.instanceId()
+        ).increment();
+        log.atWarn()
+                .addKeyValue("event", "realtime.authorization.termination.failed")
+                .addKeyValue("instance_id", properties.instanceId())
+                .addKeyValue("reason", reason.metricValue())
+                .addKeyValue("failure_stage", "transport-close")
+                .addKeyValue("exception_type", exception.getClass().getName())
+                .addKeyValue("root_cause_type", rootCauseType(exception))
+                .addKeyValue("outcome", "failed")
+                .log("Realtime WebSocket authorization termination failed");
+    }
+
+    public void authorizationTerminationRetryRejected(
+            RealtimeWebSocketTerminationReason reason,
+            RuntimeException exception
+    ) {
+        meterRegistry.counter(
+                "ssing.realtime.authorization.termination.failures",
+                "reason", reason.metricValue(),
+                "failure_stage", "retry-schedule",
+                "instance_id", properties.instanceId()
+        ).increment();
+        log.atWarn()
+                .addKeyValue("event", "realtime.authorization.termination_retry.rejected")
+                .addKeyValue("instance_id", properties.instanceId())
+                .addKeyValue("reason", reason.metricValue())
+                .addKeyValue("failure_stage", "retry-schedule")
+                .addKeyValue("exception_type", exception.getClass().getName())
+                .addKeyValue("root_cause_type", rootCauseType(exception))
+                .addKeyValue("outcome", "rejected")
+                .log("Realtime WebSocket authorization termination retry was rejected");
+    }
+
+    public void authorizationTerminationRetriesExhausted(
+            RealtimeWebSocketTerminationReason reason,
+            int closeAttemptCount
+    ) {
+        meterRegistry.counter(
+                "ssing.realtime.authorization.termination.failures",
+                "reason", reason.metricValue(),
+                "failure_stage", "retry-exhausted",
+                "instance_id", properties.instanceId()
+        ).increment();
+        log.atWarn()
+                .addKeyValue("event", "realtime.authorization.termination_retry.exhausted")
+                .addKeyValue("instance_id", properties.instanceId())
+                .addKeyValue("reason", reason.metricValue())
+                .addKeyValue("failure_stage", "retry-exhausted")
+                .addKeyValue("close_attempt_count", closeAttemptCount)
+                .addKeyValue("outcome", "exhausted")
+                .log("Realtime WebSocket authorization termination retries exhausted");
+    }
+
+    public void authorizationRecheckSucceeded(
+            int sessionCount,
+            int memberCount,
+            int terminationRequestedSessionCount,
+            long elapsedNanos
+    ) {
+        meterRegistry.counter(
+                "ssing.realtime.authorization.rechecks",
+                "outcome", "succeeded",
+                "instance_id", properties.instanceId()
+        ).increment();
+        Timer.builder("ssing.realtime.authorization.recheck.duration")
+                .tag("outcome", "succeeded")
+                .tag("instance_id", properties.instanceId())
+                .register(meterRegistry)
+                .record(Duration.ofNanos(elapsedNanos));
+        log.atInfo()
+                .addKeyValue("event", "realtime.authorization.recheck.completed")
+                .addKeyValue("instance_id", properties.instanceId())
+                .addKeyValue("session_count", sessionCount)
+                .addKeyValue("member_count", memberCount)
+                .addKeyValue("termination_requested_session_count", terminationRequestedSessionCount)
+                .addKeyValue("outcome", "succeeded")
+                .log("Realtime WebSocket authorization recheck completed");
+    }
+
+    public void authorizationRecheckFailed(
+            int sessionCount,
+            int memberCount,
+            RuntimeException exception,
+            long elapsedNanos
+    ) {
+        meterRegistry.counter(
+                "ssing.realtime.authorization.rechecks",
+                "outcome", "failed_open",
+                "instance_id", properties.instanceId()
+        ).increment();
+        Timer.builder("ssing.realtime.authorization.recheck.duration")
+                .tag("outcome", "failed_open")
+                .tag("instance_id", properties.instanceId())
+                .register(meterRegistry)
+                .record(Duration.ofNanos(elapsedNanos));
+        log.atWarn()
+                .addKeyValue("event", "realtime.authorization.recheck.failed")
+                .addKeyValue("instance_id", properties.instanceId())
+                .addKeyValue("session_count", sessionCount)
+                .addKeyValue("member_count", memberCount)
+                .addKeyValue("exception_type", exception.getClass().getName())
+                .addKeyValue("root_cause_type", rootCauseType(exception))
+                .addKeyValue("outcome", "failed_open")
+                .log("Realtime WebSocket authorization recheck failed open");
+    }
+
+    public void subscribed(
+            String sessionId,
+            String subscriptionId,
+            String destination
+    ) {
+        commandCounter("SUBSCRIBE", "accepted", normalizeDestination(destination), "none").increment();
+        log.atInfo()
+                .addKeyValue("event", "realtime.stomp.subscription.accepted")
+                .addKeyValue("instance_id", properties.instanceId())
+                .addKeyValue("session_id", safeSessionId(sessionId))
+                .addKeyValue("command", "SUBSCRIBE")
+                .addKeyValue("destination", normalizeDestination(destination))
+                .addKeyValue("outcome", "accepted")
+                .log("Realtime STOMP subscription accepted");
+    }
+
+    public void unsubscribed(
+            String sessionId,
+            String subscriptionId
+    ) {
+        commandCounter("UNSUBSCRIBE", "accepted", "NONE", "none").increment();
+    }
+
+    public void commandRejected(
+            StompCommand command,
+            String destination,
+            String sessionId,
+            RuntimeException exception
+    ) {
+        String normalizedCommand = command == null ? "UNKNOWN" : command.name();
+        String normalizedDestination = normalizeDestination(destination);
+        String failureStage = failureStage(command);
+        ErrorCode errorCode = resolveErrorCode(exception);
+        commandCounter(normalizedCommand, "rejected", normalizedDestination, failureStage).increment();
+
+        log.atWarn()
+                .addKeyValue("event", "realtime.stomp.command.rejected")
+                .addKeyValue("instance_id", properties.instanceId())
+                .addKeyValue("session_id", safeSessionId(sessionId))
+                .addKeyValue("command", normalizedCommand)
+                .addKeyValue("destination", normalizedDestination)
+                .addKeyValue("failure_stage", failureStage)
+                .addKeyValue("error_code", errorCode.getCode())
+                .addKeyValue("exception_type", exception.getClass().getName())
+                .addKeyValue("outcome", "rejected")
+                .log("Realtime STOMP command rejected");
+    }
+
+    public void publishAttempt(
+            String domain,
+            UUID eventId,
+            String eventType,
+            String destination
+    ) {
+        meterRegistry.counter(
+                "ssing.realtime.publish.attempts",
+                "domain", domain,
+                "event_type", eventType,
+                "destination", normalizeDestination(destination),
+                "instance_id", properties.instanceId()
+        ).increment();
+    }
+
+    public void publishChannelAccepted(
+            String domain,
+            UUID eventId,
+            String eventType,
+            String destination,
+            long elapsedNanos
+    ) {
+        String normalizedDestination = normalizeDestination(destination);
+        meterRegistry.counter(
+                "ssing.realtime.publish.channel.accepted",
+                "domain", domain,
+                "event_type", eventType,
+                "destination", normalizedDestination,
+                "instance_id", properties.instanceId()
+        ).increment();
+        recordPublishEnqueue(domain, eventType, normalizedDestination, "channel_accepted", elapsedNanos);
+
+        log.atInfo()
+                .addKeyValue("event", "realtime.publish.channel_accepted")
+                .addKeyValue("instance_id", properties.instanceId())
+                .addKeyValue("event_id", eventId == null ? null : eventId.toString())
+                .addKeyValue("domain", domain)
+                .addKeyValue("event_type", eventType)
+                .addKeyValue("destination", normalizedDestination)
+                .addKeyValue("outcome", "channel_accepted")
+                .log("Realtime event was accepted by the local message channel");
+    }
+
+    public void publishFailure(
+            String domain,
+            UUID eventId,
+            String eventType,
+            String destination,
+            String failureStage,
+            RuntimeException exception,
+            long elapsedNanos
+    ) {
+        String normalizedDestination = normalizeDestination(destination);
+        meterRegistry.counter(
+                "ssing.realtime.publish.failures",
+                "domain", domain,
+                "event_type", eventType,
+                "destination", normalizedDestination,
+                "failure_stage", failureStage,
+                "instance_id", properties.instanceId()
+        ).increment();
+        recordPublishEnqueue(domain, eventType, normalizedDestination, "sync_failed", elapsedNanos);
+
+        log.atWarn()
+                .addKeyValue("event", "realtime.publish.failed")
+                .addKeyValue("instance_id", properties.instanceId())
+                .addKeyValue("event_id", eventId == null ? null : eventId.toString())
+                .addKeyValue("domain", domain)
+                .addKeyValue("event_type", eventType)
+                .addKeyValue("destination", normalizedDestination)
+                .addKeyValue("failure_stage", failureStage)
+                .addKeyValue("exception_type", exception.getClass().getName())
+                .addKeyValue("root_cause_type", rootCauseType(exception))
+                .addKeyValue("outcome", "sync_failed")
+                .log("Realtime event publish failed before delivery confirmation");
+    }
+
+    public void publishSkipped(
+            String domain,
+            UUID eventId,
+            String eventType,
+            String failureStage
+    ) {
+        meterRegistry.counter(
+                "ssing.realtime.publish.skipped",
+                "domain", domain,
+                "event_type", eventType,
+                "failure_stage", failureStage,
+                "instance_id", properties.instanceId()
+        ).increment();
+        log.atWarn()
+                .addKeyValue("event", "realtime.publish.skipped")
+                .addKeyValue("instance_id", properties.instanceId())
+                .addKeyValue("event_id", eventId == null ? null : eventId.toString())
+                .addKeyValue("domain", domain)
+                .addKeyValue("event_type", eventType)
+                .addKeyValue("failure_stage", failureStage)
+                .addKeyValue("outcome", "skipped")
+                .log("Realtime event publish was skipped");
+    }
+
+    public void internalClientProcessingFailure(RuntimeException exception) {
+        meterRegistry.counter(
+                "ssing.realtime.stomp.internal.failures",
+                "failure_stage", "client-message-processing",
+                "instance_id", properties.instanceId()
+        ).increment();
+        log.atError()
+                .addKeyValue("event", "realtime.stomp.client_processing.failed")
+                .addKeyValue("instance_id", properties.instanceId())
+                .addKeyValue("failure_stage", "client-message-processing")
+                .addKeyValue("exception_type", exception.getClass().getName())
+                .addKeyValue("root_cause_type", rootCauseType(exception))
+                .log("Realtime STOMP client message processing failed");
+    }
+
+    public void brokerErrorSanitized() {
+        meterRegistry.counter(
+                "ssing.realtime.stomp.internal.failures",
+                "failure_stage", "broker-error-sanitization",
+                "instance_id", properties.instanceId()
+        ).increment();
+        log.atError()
+                .addKeyValue("event", "realtime.stomp.broker_error.sanitized")
+                .addKeyValue("instance_id", properties.instanceId())
+                .addKeyValue("failure_stage", "broker-error-sanitization")
+                .log("Realtime broker error was sanitized");
+    }
+
+    @Scheduled(
+            fixedDelayString = "${ssing.realtime.websocket.observability-log-interval:PT1M}",
+            scheduler = RealtimeWebSocketLifecycleConfig.LIFECYCLE_SCHEDULER_BEAN
+    )
+    void logSnapshot() {
+        int inboundQueueSize = inboundExecutor.getQueueSize();
+        int outboundQueueSize = outboundExecutor.getQueueSize();
+        boolean queuePressure = inboundQueueSize >= properties.inboundExecutor().queueWarningThreshold()
+                || outboundQueueSize >= properties.outboundExecutor().queueWarningThreshold();
+        LoggingEventBuilder builder = queuePressure ? log.atWarn() : log.atInfo();
+        builder
+                .addKeyValue("event", "realtime.stomp.snapshot")
+                .addKeyValue("instance_id", properties.instanceId())
+                .addKeyValue("active_session_count", subscriptionLimiter.connectedSessionCount())
+                .addKeyValue("active_subscription_count", subscriptionLimiter.activeSubscriptionCount())
+                .addKeyValue("inbound_active_count", inboundExecutor.getActiveCount())
+                .addKeyValue("inbound_queue_size", inboundQueueSize)
+                .addKeyValue("outbound_active_count", outboundExecutor.getActiveCount())
+                .addKeyValue("outbound_queue_size", outboundQueueSize)
+                .addKeyValue("queue_pressure", queuePressure)
+                .log("Realtime STOMP local instance snapshot");
+    }
+
+    String safeSessionId(String sessionId) {
+        if (sessionId == null || sessionId.isBlank()) {
+            return "unknown";
+        }
+        try {
+            Mac mac = Mac.getInstance(HMAC_ALGORITHM);
+            mac.init(new SecretKeySpec(sessionHashKey, HMAC_ALGORITHM));
+            byte[] digest = mac.doFinal(sessionId.getBytes(StandardCharsets.UTF_8));
+            return HexFormat.of().formatHex(digest, 0, SESSION_HASH_BYTES);
+        } catch (GeneralSecurityException exception) {
+            throw new IllegalStateException("HMAC-SHA256 is unavailable.", exception);
+        }
+    }
+
+    private void registerGauges() {
+        Gauge.builder(
+                        "ssing.realtime.stomp.sessions.authenticated.active",
+                        subscriptionLimiter,
+                        RealtimeStompSubscriptionLimiter::connectedSessionCount
+                )
+                .description("Current authenticated STOMP sessions on this instance")
+                .tag("instance_id", properties.instanceId())
+                .register(meterRegistry);
+        Gauge.builder(
+                        "ssing.realtime.stomp.subscriptions.active",
+                        subscriptionLimiter,
+                        RealtimeStompSubscriptionLimiter::activeSubscriptionCount
+                )
+                .description("Current accepted STOMP subscriptions on this instance")
+                .tag("instance_id", properties.instanceId())
+                .register(meterRegistry);
+        registerExecutorGauges("inbound", inboundExecutor);
+        registerExecutorGauges("outbound", outboundExecutor);
+    }
+
+    private void registerExecutorGauges(
+            String channel,
+            ThreadPoolTaskExecutor executor
+    ) {
+        Gauge.builder("ssing.realtime.executor.active", executor, ThreadPoolTaskExecutor::getActiveCount)
+                .tag("channel", channel)
+                .tag("instance_id", properties.instanceId())
+                .register(meterRegistry);
+        Gauge.builder("ssing.realtime.executor.pool.size", executor, ThreadPoolTaskExecutor::getPoolSize)
+                .tag("channel", channel)
+                .tag("instance_id", properties.instanceId())
+                .register(meterRegistry);
+        Gauge.builder("ssing.realtime.executor.queue.size", executor, ThreadPoolTaskExecutor::getQueueSize)
+                .tag("channel", channel)
+                .tag("instance_id", properties.instanceId())
+                .register(meterRegistry);
+        Gauge.builder(
+                        "ssing.realtime.executor.queue.remaining",
+                        executor,
+                        value -> value.getThreadPoolExecutor().getQueue().remainingCapacity()
+                )
+                .tag("channel", channel)
+                .tag("instance_id", properties.instanceId())
+                .register(meterRegistry);
+    }
+
+    private Counter commandCounter(
+            String command,
+            String outcome,
+            String destination,
+            String failureStage
+    ) {
+        return meterRegistry.counter(
+                "ssing.realtime.stomp.commands",
+                "command", command,
+                "outcome", outcome,
+                "destination", destination,
+                "failure_stage", failureStage,
+                "instance_id", properties.instanceId()
+        );
+    }
+
+    private void recordPublishEnqueue(
+            String domain,
+            String eventType,
+            String destination,
+            String outcome,
+            long elapsedNanos
+    ) {
+        Timer.builder("ssing.realtime.publish.channel.enqueue")
+                .description("Time spent submitting realtime events to the local message channel")
+                .tag("domain", domain)
+                .tag("event_type", eventType)
+                .tag("destination", destination)
+                .tag("outcome", outcome)
+                .tag("instance_id", properties.instanceId())
+                .register(meterRegistry)
+                .record(Duration.ofNanos(Math.max(0, elapsedNanos)));
+    }
+
+    private String failureStage(StompCommand command) {
+        if (StompCommand.CONNECT.equals(command) || StompCommand.STOMP.equals(command)) {
+            return "connect-authentication";
+        }
+        if (StompCommand.SUBSCRIBE.equals(command)) {
+            return "subscribe-authorization";
+        }
+        return "command-validation";
+    }
+
+    private ErrorCode resolveErrorCode(RuntimeException exception) {
+        Throwable cause = exception;
+        while (cause != null) {
+            if (cause instanceof AccessTokenException accessTokenException) {
+                return accessTokenException.getErrorCode();
+            }
+            if (cause instanceof BusinessException businessException) {
+                return businessException.getErrorCode();
+            }
+            if (cause instanceof AccessDeniedException) {
+                return CommonErrorCode.FORBIDDEN;
+            }
+            cause = cause.getCause();
+        }
+        return CommonErrorCode.INTERNAL_ERROR;
+    }
+
+    private String normalizeDestination(String destination) {
+        if (destination == null || destination.isBlank()) {
+            return "NONE";
+        }
+        if (destination.equals("/user/queue/matching") || destination.equals("/queue/matching")) {
+            return "MATCHING";
+        }
+        if (destination.equals("/user/queue/lesson") || destination.equals("/queue/lesson")) {
+            return "LESSON";
+        }
+        return "OTHER";
+    }
+
+    private String normalizeCloseStatus(CloseStatus closeStatus) {
+        if (closeStatus == null) {
+            return "UNKNOWN";
+        }
+        if (CloseStatus.NORMAL.getCode() == closeStatus.getCode()) {
+            return "NORMAL";
+        }
+        if (CloseStatus.GOING_AWAY.getCode() == closeStatus.getCode()) {
+            return "GOING_AWAY";
+        }
+        if (CloseStatus.SESSION_NOT_RELIABLE.getCode() == closeStatus.getCode()) {
+            return "SESSION_NOT_RELIABLE";
+        }
+        if (RealtimeWebSocketTerminationReason.ACCESS_TOKEN_EXPIRED.closeStatus().getCode()
+                == closeStatus.getCode()) {
+            return "AUTH_TOKEN_EXPIRED";
+        }
+        if (RealtimeWebSocketTerminationReason.ACCESS_REVOKED.closeStatus().getCode()
+                == closeStatus.getCode()) {
+            return "REALTIME_ACCESS_REVOKED";
+        }
+        if (RealtimeWebSocketTerminationReason.AUTH_CONTEXT_CHANGED.closeStatus().getCode()
+                == closeStatus.getCode()) {
+            return "AUTH_CONTEXT_CHANGED";
+        }
+        return "ABNORMAL";
+    }
+
+    private String rootCauseType(Throwable exception) {
+        Throwable rootCause = exception;
+        while (rootCause.getCause() != null) {
+            rootCause = rootCause.getCause();
+        }
+        return rootCause.getClass().getName();
+    }
+}
