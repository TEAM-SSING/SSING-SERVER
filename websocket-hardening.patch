+    @Test
+    @Transactional(propagation = Propagation.NOT_SUPPORTED)
+    void 같은_REQUESTED_요청을_두_runner가_동시에_탐색해도_한번만_그룹과_제안을_만든다() throws Exception {
+        Fixture fixture = transactionTemplate.execute(status -> persistFixture());
+        CountDownLatch firstSearchOwnsRequestLock = new CountDownLatch(1);
+        CountDownLatch releaseFirstSearch = new CountDownLatch(1);
+        AtomicInteger candidateLookupCount = new AtomicInteger();
+        givenCandidateLookupWaitsAfterRequestLock(
+                fixture,
+                candidateLookupCount,
+                firstSearchOwnsRequestLock,
+                releaseFirstSearch
+        );
+        RequestLockSqlInspector.expectRequestLockQueries(2);
+
+        CountDownLatch runnersReady = new CountDownLatch(2);
+        CountDownLatch startTogether = new CountDownLatch(1);
+        ExecutorService executor = Executors.newFixedThreadPool(2);
+
+        try {
+            Future<MatchingSearchResult> firstRunner = executor.submit(
+                    () -> searchAfterStartSignal(fixture.matchingRequestId(), runnersReady, startTogether)
+            );
+            Future<MatchingSearchResult> secondRunner = executor.submit(
+                    () -> searchAfterStartSignal(fixture.matchingRequestId(), runnersReady, startTogether)
+            );
+            assertThat(runnersReady.await(5, TimeUnit.SECONDS)).isTrue();
+            assertThat(TransactionSynchronizationManager.isActualTransactionActive()).isFalse();
+            startTogether.countDown();
+
+            // 첫 runner가 REQUESTED row lock을 잡은 뒤 멈춘 동안 두 번째 FOR UPDATE도 실행시켜 실제 경합을 만든다.
+            assertThat(firstSearchOwnsRequestLock.await(5, TimeUnit.SECONDS)).isTrue();
+            assertThat(RequestLockSqlInspector.awaitExpectedQueries(5, TimeUnit.SECONDS)).isTrue();
+            releaseFirstSearch.countDown();
+
+            List<MatchingSearchResult> results = List.of(
+                    firstRunner.get(10, TimeUnit.SECONDS),
+                    secondRunner.get(10, TimeUnit.SECONDS)
+            );
+
+            assertThat(results).filteredOn(MatchingSearchResult::isSkipped).hasSize(1);
+            assertThat(results)
+                    .filteredOn(result -> !result.isSkipped())
+                    .singleElement()
+                    .satisfies(result -> {
+                        assertThat(result.matchingStatus()).isSameAs(MatchingStatus.WAITING_FOR_INSTRUCTOR);
+                        assertThat(result.requestStatus()).isSameAs(MatchingRequestStatus.GROUPED);
+                    });
+            assertThat(candidateLookupCount).hasValue(1);
+            assertPersistedOnlyOnce(fixture.matchingRequestId());
+            verify(matchingEventPublisher, times(1)).publish(isA(MatchingOfferCreatedEvent.class));
+        } finally {
+            startTogether.countDown();
+            releaseFirstSearch.countDown();
+            executor.shutdownNow();
+        }
+    }
