+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.jdbc.core.namedparam.NamedParameterJdbcTemplate;
+import org.springframework.jdbc.datasource.DriverManagerDataSource;
+import org.springframework.jdbc.support.JdbcTransactionManager;
+import org.springframework.transaction.TransactionDefinition;
+import org.springframework.transaction.support.TransactionTemplate;
+import org.testcontainers.containers.MySQLContainer;
+import org.testcontainers.junit.jupiter.Container;
+import org.testcontainers.junit.jupiter.Testcontainers;
+
+@Testcontainers(disabledWithoutDocker = true)
+class MatchingSearchClaimRepositoryMySqlIntegrationTest {
+
+    @Container
+    private static final MySQLContainer<?> MYSQL = new MySQLContainer<>("mysql:8.4.8");
+
+    private static JdbcTemplate jdbcTemplate;
+    private static MatchingSearchClaimRepository claimRepository;
+    private static TransactionTemplate transactionTemplate;
+
+    @BeforeAll
+    static void setUpDatabase() {
+        DataSource dataSource = new DriverManagerDataSource(
+                MYSQL.getJdbcUrl(),
+                MYSQL.getUsername(),
+                MYSQL.getPassword()
+        );
+        jdbcTemplate = new JdbcTemplate(dataSource);
+        claimRepository = new MatchingSearchClaimRepository(new NamedParameterJdbcTemplate(dataSource));
+        transactionTemplate = new TransactionTemplate(new JdbcTransactionManager(dataSource));
+        transactionTemplate.setIsolationLevel(TransactionDefinition.ISOLATION_READ_COMMITTED);
+
+        jdbcTemplate.execute("""
+                CREATE TABLE matching_requests (
+                    id BIGINT NOT NULL AUTO_INCREMENT,
+                    status VARCHAR(40) NOT NULL,
+                    next_search_at DATETIME(6) NULL,
+                    created_at DATETIME(6) NOT NULL,
+                    search_due_at DATETIME(6)
+                        GENERATED ALWAYS AS (COALESCE(next_search_at, created_at)) VIRTUAL,
+                    PRIMARY KEY (id),
+                    INDEX idx_matching_requests_search_due(status, search_due_at, id)
+                )
+                """);
+    }
+
+    @BeforeEach
+    void clearRequests() {
+        jdbcTemplate.execute("TRUNCATE TABLE matching_requests");
+    }
+
+    @Test
+    void 앞_100건이_REQUESTED여도_두번째_claim은_101번째까지_진행한다() {
+        insertDueRequests(101);
+
+        List<Long> firstBatch = claim(100, Duration.ofMinutes(1));
+        List<Long> secondBatch = claim(100, Duration.ofMinutes(1));
+
+        assertThat(firstBatch).containsExactlyElementsOf(longRange(1, 100));
+        assertThat(secondBatch).containsExactly(101L);
+    }
+
+    @Test
+    void 빈_테이블은_update_SQL을_만들지_않고_빈_claim으로_끝난다() {
+        assertThat(claim(100, Duration.ofMinutes(10))).isEmpty();
+    }
+
+    @Test
+    void 미래_요청과_REQUESTED가_아닌_요청은_제외하고_최초요청과_due시각순으로_claim한다() {
+        jdbcTemplate.update("""
+                INSERT INTO matching_requests(id, status, next_search_at, created_at)
+                VALUES
+                    (1, 'REQUESTED', TIMESTAMPADD(HOUR, 1, UTC_TIMESTAMP(6)),
+                        TIMESTAMPADD(DAY, -1, UTC_TIMESTAMP(6))),
+                    (2, 'REQUESTED', NULL, TIMESTAMPADD(MINUTE, -10, UTC_TIMESTAMP(6))),
+                    (3, 'REQUESTED', TIMESTAMPADD(MINUTE, -20, UTC_TIMESTAMP(6)), UTC_TIMESTAMP(6)),
+                    (4, 'REQUESTED', NULL, TIMESTAMPADD(MINUTE, -30, UTC_TIMESTAMP(6))),
+                    (5, 'GROUPED', NULL, TIMESTAMPADD(DAY, -2, UTC_TIMESTAMP(6)))
+                """);
+
+        List<Long> claimedIds = claim(10, Duration.ofMinutes(1));
+
+        assertThat(claimedIds).containsExactly(4L, 3L, 2L);
+    }
+
+    @Test
+    void claim트랜잭션이_rollback되면_같은_요청을_다시_claim할수있다() {
+        insertDueRequests(3);
+        AtomicReference<List<Long>> rolledBackClaim = new AtomicReference<>();
+
+        transactionTemplate.executeWithoutResult(status -> {
+            rolledBackClaim.set(claimRepository.claimDueRequestIds(3, Duration.ofMinutes(1)));
+            status.setRollbackOnly();
+        });
+
+        assertThat(rolledBackClaim.get()).containsExactly(1L, 2L, 3L);
+        assertThat(claim(3, Duration.ofMinutes(1))).containsExactly(1L, 2L, 3L);
+    }
+
+    @Test
+    void 저장된_claim보호시각이_지나면_요청을_다시_claim한다() {
+        insertDueRequests(1);
+
+        assertThat(claim(1, Duration.ofMinutes(10))).containsExactly(1L);
+        assertThat(claim(1, Duration.ofMinutes(10))).isEmpty();
+
+        jdbcTemplate.update("""
+                UPDATE matching_requests
+                SET next_search_at = TIMESTAMPADD(MICROSECOND, -1, UTC_TIMESTAMP(6))
+                WHERE id = 1
+                """);
+
+        assertThat(claim(1, Duration.ofMinutes(10))).containsExactly(1L);
+    }
+
+    @Test
+    void 정상탐색_완료는_애플리케이션시계가_아닌_DB시각으로_다음재시도를_예약한다() {
+        insertDueRequests(1);
+
+        transactionTemplate.executeWithoutResult(status ->
+                claimRepository.scheduleNextRetry(1L, Duration.ofMinutes(1))
+        );
+
+        Long secondsUntilRetry = jdbcTemplate.queryForObject("""
+                SELECT TIMESTAMPDIFF(SECOND, UTC_TIMESTAMP(6), next_search_at)
+                FROM matching_requests
+                WHERE id = 1
+                """, Long.class);
+        assertThat(secondsUntilRetry).isBetween(55L, 60L);
+    }
+
+    @Test
+    void 쓰기가능한_트랜잭션_밖에서는_row선점_안전장치를_잃지않고_실패한다() {
+        insertDueRequests(1);
+
+        assertThatThrownBy(() -> claimRepository.claimDueRequestIds(1, Duration.ofMinutes(1)))
+                .isInstanceOf(IllegalStateException.class)
+                .hasMessage("Matching search claim requires an active writable transaction.");
+        assertThat(jdbcTemplate.queryForObject(
+                "SELECT next_search_at FROM matching_requests WHERE id = 1",
+                Object.class
+        )).isNull();
+    }
+
+    @Test
+    void readOnly_트랜잭션에서는_claim을_거부한다() {
+        insertDueRequests(1);
+        TransactionTemplate readOnlyTransaction = new TransactionTemplate(
+                new JdbcTransactionManager(jdbcTemplate.getDataSource())
+        );
+        readOnlyTransaction.setReadOnly(true);
+
+        assertThatThrownBy(() -> readOnlyTransaction.executeWithoutResult(status ->
+                claimRepository.claimDueRequestIds(1, Duration.ofMinutes(1))
+        ))
+                .isInstanceOf(IllegalStateException.class)
+                .hasMessage("Matching search claim requires an active writable transaction.");
+        assertThat(jdbcTemplate.queryForObject(
+                "SELECT next_search_at FROM matching_requests WHERE id = 1",
+                Object.class
+        )).isNull();
+    }
+
+    @Test
+    void 두_동시_claim트랜잭션은_lock된_row를_건너뛰고_서로_다른_요청을_나눠갖는다() throws Exception {
+        insertDueRequests(20);
+        CountDownLatch firstClaimCompleted = new CountDownLatch(1);
+        CountDownLatch secondTransactionCompleted = new CountDownLatch(1);
+        ExecutorService executor = Executors.newFixedThreadPool(2);
+
+        try {
+            Future<List<Long>> firstFuture = executor.submit(() -> transactionTemplate.execute(status -> {
+                List<Long> claimedIds = claimRepository.claimDueRequestIds(10, Duration.ofMinutes(5));
+                firstClaimCompleted.countDown();
+                await(secondTransactionCompleted);
+                return claimedIds;
+            }));
+
+            Future<List<Long>> secondFuture = executor.submit(() -> {
+                await(firstClaimCompleted);
+                try {
+                    return transactionTemplate.execute(status ->
+                            claimRepository.claimDueRequestIds(10, Duration.ofMinutes(5))
+                    );
+                } finally {
+                    secondTransactionCompleted.countDown();
+                }
+            });
+
+            List<Long> firstClaim = firstFuture.get(10, TimeUnit.SECONDS);
+            List<Long> secondClaim = secondFuture.get(10, TimeUnit.SECONDS);
+
+            assertThat(firstClaim).hasSize(10);
+            assertThat(secondClaim).hasSize(10);
+            assertThat(firstClaim).doesNotContainAnyElementsOf(secondClaim);
+
+            HashSet<Long> allClaimedIds = new HashSet<>(firstClaim);
+            allClaimedIds.addAll(secondClaim);
+            assertThat(allClaimedIds).containsExactlyInAnyOrderElementsOf(longRange(1, 20));
+        } finally {
+            executor.shutdownNow();
+        }
+    }
+
+    private static List<Long> claim(int batchSize, Duration claimLease) {
+        return transactionTemplate.execute(status ->
+                claimRepository.claimDueRequestIds(batchSize, claimLease)
+        );
+    }
+
+    private static void insertDueRequests(int count) {
+        for (int index = 1; index <= count; index++) {
+            jdbcTemplate.update("""
+                    INSERT INTO matching_requests(status, next_search_at, created_at)
+                    VALUES ('REQUESTED', NULL, TIMESTAMPADD(MICROSECOND, ?, UTC_TIMESTAMP(6)))
+                    """, index - count);
+        }
+    }
+
+    private static List<Long> longRange(int startInclusive, int endInclusive) {
+        return java.util.stream.LongStream.rangeClosed(startInclusive, endInclusive)
+                .boxed()
+                .toList();
+    }
+
+    private static void await(CountDownLatch latch) {
+        try {
+            if (!latch.await(5, TimeUnit.SECONDS)) {
+                throw new IllegalStateException("Concurrent claim test latch timed out.");
+            }
+        } catch (InterruptedException exception) {
+            Thread.currentThread().interrupt();
+            throw new IllegalStateException("Concurrent claim test was interrupted.", exception);
+        }
+    }
+}
