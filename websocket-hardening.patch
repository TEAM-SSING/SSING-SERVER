+import static org.mockito.Mockito.when;
+
+import java.time.Clock;
+import java.time.Instant;
+import java.time.ZoneOffset;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import org.junit.jupiter.api.Test;
+import org.sopt.ssingserver.domain.member.enums.MemberRole;
+import org.sopt.ssingserver.domain.member.enums.MemberStatus;
+import org.sopt.ssingserver.global.realtime.RealtimeMemberAuthorizationReader.MemberAuthorizationSnapshot;
+import org.sopt.ssingserver.global.realtime.RealtimeWebSocketSessionRegistry.AuthenticationSnapshot;
+
+class RealtimeWebSocketAuthorizationMonitorTest {
+
+    private static final Instant NOW = Instant.parse("2026-07-12T00:00:00Z");
+
+    private final RealtimeWebSocketSessionRegistry sessionRegistry = mock(RealtimeWebSocketSessionRegistry.class);
+    private final RealtimeMemberAuthorizationReader authorizationReader = mock(RealtimeMemberAuthorizationReader.class);
+    private final RealtimeWebSocketObservability observability = mock(RealtimeWebSocketObservability.class);
+    private final RealtimeWebSocketAuthorizationMonitor monitor = new RealtimeWebSocketAuthorizationMonitor(
+            sessionRegistry,
+            authorizationReader,
+            observability,
+            Clock.fixed(NOW, ZoneOffset.UTC)
+    );
+
+    @Test
+    void role변경_close_status는_4409_AUTH_CONTEXT_CHANGED로_고정한다() {
+        assertThat(RealtimeWebSocketTerminationReason.AUTH_CONTEXT_CHANGED.closeStatus().getCode())
+                .isEqualTo(4409);
+        assertThat(RealtimeWebSocketTerminationReason.AUTH_CONTEXT_CHANGED.closeStatus().getReason())
+                .isEqualTo("AUTH_CONTEXT_CHANGED");
+    }
+
+    @Test
+    void 정지_탈퇴_missing은_4403_role변경은_4409로_종료한다() {
+        List<AuthenticationSnapshot> snapshots = List.of(
+                snapshot("active", 1L, MemberRole.CONSUMER),
+                snapshot("suspended", 2L, MemberRole.CONSUMER),
+                snapshot("withdrawn", 3L, MemberRole.CONSUMER),
+                snapshot("missing", 4L, MemberRole.CONSUMER),
+                snapshot("role-changed", 5L, MemberRole.CONSUMER)
+        );
+        when(sessionRegistry.authenticatedSessions()).thenReturn(snapshots);
+        when(authorizationReader.findAll(Set.of(1L, 2L, 3L, 4L, 5L))).thenReturn(Map.of(
+                1L, member(1L, MemberRole.CONSUMER, MemberStatus.ACTIVE),
+                2L, member(2L, MemberRole.CONSUMER, MemberStatus.SUSPENDED),
+                3L, member(3L, MemberRole.CONSUMER, MemberStatus.WITHDRAWN),
+                5L, member(5L, MemberRole.INSTRUCTOR, MemberStatus.ACTIVE)
+        ));
+        when(sessionRegistry.terminate(
+                org.mockito.ArgumentMatchers.anyString(),
+                org.mockito.ArgumentMatchers.any()
+        )).thenReturn(true);
+
+        monitor.revalidateActiveSessions();
+
+        verify(sessionRegistry, never()).terminate(
+                org.mockito.ArgumentMatchers.eq("active"),
+                org.mockito.ArgumentMatchers.any()
+        );
+        verify(sessionRegistry).terminate("suspended", RealtimeWebSocketTerminationReason.ACCESS_REVOKED);
+        verify(sessionRegistry).terminate("withdrawn", RealtimeWebSocketTerminationReason.ACCESS_REVOKED);
+        verify(sessionRegistry).terminate("missing", RealtimeWebSocketTerminationReason.ACCESS_REVOKED);
+        verify(sessionRegistry).terminate(
+                "role-changed",
+                RealtimeWebSocketTerminationReason.AUTH_CONTEXT_CHANGED
+        );
+        verify(observability).authorizationRecheckSucceeded(
+                org.mockito.ArgumentMatchers.eq(5),
+                org.mockito.ArgumentMatchers.eq(5),
+                org.mockito.ArgumentMatchers.eq(4),
+                anyLong()
+        );
+    }
+
+    @Test
+    void 같은_member의_여러_session도_member는_한번만_bulk조회한다() {
+        when(sessionRegistry.authenticatedSessions()).thenReturn(List.of(
+                snapshot("device-1", 12L, MemberRole.CONSUMER),
+                snapshot("device-2", 12L, MemberRole.CONSUMER)
+        ));
+        when(authorizationReader.findAll(Set.of(12L))).thenReturn(Map.of(
+                12L, member(12L, MemberRole.CONSUMER, MemberStatus.ACTIVE)
+        ));
+
+        monitor.revalidateActiveSessions();
+
+        verify(authorizationReader).findAll(Set.of(12L));
+        verify(sessionRegistry, never()).terminate(
+                org.mockito.ArgumentMatchers.anyString(),
+                org.mockito.ArgumentMatchers.any()
+        );
+    }
+
+    @Test
+    void DB_recheck가_실패하면_기존_session을_유지하고_다음주기로_넘긴다() {
+        when(sessionRegistry.authenticatedSessions()).thenReturn(List.of(
+                snapshot("session-1", 12L, MemberRole.CONSUMER)
+        ));
+        RuntimeException databaseFailure = new IllegalStateException("database unavailable");
+        when(authorizationReader.findAll(Set.of(12L))).thenThrow(databaseFailure);
+
+        monitor.revalidateActiveSessions();
+
+        verify(sessionRegistry, never()).terminate(
+                org.mockito.ArgumentMatchers.anyString(),
+                org.mockito.ArgumentMatchers.any()
+        );
+        verify(observability).authorizationRecheckFailed(
+                org.mockito.ArgumentMatchers.eq(1),
+                org.mockito.ArgumentMatchers.eq(1),
+                org.mockito.ArgumentMatchers.same(databaseFailure),
+                anyLong()
+        );
+    }
+
+    @Test
+    void DB가_실패해도_이미_만료된_session은_조회없이_4401로_종료한다() {
+        AuthenticationSnapshot expired = new AuthenticationSnapshot(
+                "expired",
+                12L,
+                MemberRole.CONSUMER,
+                NOW
+        );
+        when(sessionRegistry.authenticatedSessions()).thenReturn(List.of(expired));
+        when(sessionRegistry.terminate(
+                "expired",
+                RealtimeWebSocketTerminationReason.ACCESS_TOKEN_EXPIRED
+        )).thenReturn(true);
+
+        monitor.revalidateActiveSessions();
+
+        verify(sessionRegistry).terminate(
+                "expired",
+                RealtimeWebSocketTerminationReason.ACCESS_TOKEN_EXPIRED
+        );
+        verify(authorizationReader, never()).findAll(org.mockito.ArgumentMatchers.anySet());
+        verify(observability).authorizationRecheckSucceeded(
+                org.mockito.ArgumentMatchers.eq(1),
+                org.mockito.ArgumentMatchers.eq(0),
+                org.mockito.ArgumentMatchers.eq(1),
+                anyLong()
+        );
+    }
+
+    private AuthenticationSnapshot snapshot(
+            String sessionId,
+            Long memberId,
+            MemberRole role
+    ) {
+        return new AuthenticationSnapshot(sessionId, memberId, role, NOW.plusSeconds(60));
+    }
+
+    private MemberAuthorizationSnapshot member(
+            Long memberId,
+            MemberRole role,
+            MemberStatus status
+    ) {
+        return new MemberAuthorizationSnapshot(memberId, role, status);
+    }
+}
