@@ -0,0 +1,150 @@
+package org.sopt.ssingserver.global.realtime;
+
+import java.util.HashMap;
+import java.util.LinkedHashSet;
+import java.util.Map;
+import java.util.Set;
+import org.springframework.security.access.AccessDeniedException;
+import org.springframework.stereotype.Component;
+
+@Component
+public class RealtimeStompSubscriptionLimiter {
+
+    private static final int MAX_SUBSCRIPTIONS_PER_SESSION = 2;
+    private static final int MAX_SUBSCRIPTION_ID_LENGTH = 128;
+    private static final int MAX_CLOSED_SESSION_TOMBSTONES = 10_000;
+
+    private final Map<String, SessionState> sessionStates = new HashMap<>();
+    private final Set<String> closedSessionIds = new LinkedHashSet<>();
+    private final Map<String, Map<String, String>> destinationsBySession = new HashMap<>();
+    private int connectedSessionCount;
+    private int activeSubscriptionCount;
+
+    public synchronized void markAuthenticated(String sessionId) {
+        validateSessionId(sessionId);
+        if (closedSessionIds.contains(sessionId)) {
+            throw new AccessDeniedException("Realtime session is already closed.");
+        }
+        if (sessionStates.putIfAbsent(sessionId, SessionState.AUTHENTICATED) != null) {
+            throw new AccessDeniedException("Realtime session is already authenticated.");
+        }
+    }
+
+    public synchronized boolean markConnected(String sessionId) {
+        validateSessionId(sessionId);
+        if (sessionStates.get(sessionId) != SessionState.AUTHENTICATED) {
+            return false;
+        }
+        sessionStates.put(sessionId, SessionState.CONNECTED);
+        connectedSessionCount++;
+        return true;
+    }
+
+    public synchronized void reserve(
+            String sessionId,
+            String subscriptionId,
+            String destination
+    ) {
+        validateSessionId(sessionId);
+        validateSubscriptionId(subscriptionId);
+        if (sessionStates.get(sessionId) != SessionState.CONNECTED) {
+            throw new AccessDeniedException("Realtime session is not connected.");
+        }
+
+        Map<String, String> subscriptions = destinationsBySession.getOrDefault(sessionId, Map.of());
+        if (subscriptions.containsKey(subscriptionId)) {
+            throw new AccessDeniedException("Realtime subscription id is already in use.");
+        }
+        if (subscriptions.containsValue(destination)) {
+            throw new AccessDeniedException("Realtime destination is already subscribed in this session.");
+        }
+        if (subscriptions.size() >= MAX_SUBSCRIPTIONS_PER_SESSION) {
+            throw new AccessDeniedException("Realtime session subscription limit exceeded.");
+        }
+
+        Map<String, String> updated = new HashMap<>(subscriptions);
+        updated.put(subscriptionId, destination);
+        destinationsBySession.put(sessionId, Map.copyOf(updated));
+        activeSubscriptionCount++;
+    }
+
+    public synchronized void release(
+            String sessionId,
+            String subscriptionId
+    ) {
+        validateSessionId(sessionId);
+        validateSubscriptionId(subscriptionId);
+        Map<String, String> subscriptions = destinationsBySession.get(sessionId);
+        if (subscriptions == null || !subscriptions.containsKey(subscriptionId)) {
+            return;
+        }
+
+        Map<String, String> updated = new HashMap<>(subscriptions);
+        updated.remove(subscriptionId);
+        if (updated.isEmpty()) {
+            destinationsBySession.remove(sessionId);
+        } else {
+            destinationsBySession.put(sessionId, Map.copyOf(updated));
+        }
+        activeSubscriptionCount--;
+    }
+
+    public synchronized boolean clearSession(String sessionId) {
+        if (sessionId == null || sessionId.isBlank()) {
+            return false;
+        }
+        SessionState previousState = sessionStates.remove(sessionId);
+        boolean wasConnected = previousState == SessionState.CONNECTED;
+        if (wasConnected) {
+            connectedSessionCount--;
+        }
+        Map<String, String> removed = destinationsBySession.remove(sessionId);
+        if (removed != null) {
+            activeSubscriptionCount -= removed.size();
+        }
+        rememberClosed(sessionId);
+        return wasConnected;
+    }
+
+    synchronized int connectedSessionCount() {
+        return connectedSessionCount;
+    }
+
+    synchronized int activeSubscriptionCount() {
+        return activeSubscriptionCount;
+    }
+
+    synchronized int sessionSubscriptionCount(String sessionId) {
+        return destinationsBySession.getOrDefault(sessionId, Map.of()).size();
+    }
+
+    private void rememberClosed(String sessionId) {
+        closedSessionIds.add(sessionId);
+        if (closedSessionIds.size() <= MAX_CLOSED_SESSION_TOMBSTONES) {
+            return;
+        }
+        var iterator = closedSessionIds.iterator();
+        iterator.next();
+        iterator.remove();
+    }
+
+    private void validateSessionId(String sessionId) {
+        if (sessionId == null || sessionId.isBlank()) {
+            throw new AccessDeniedException("Realtime session id is required.");
+        }
+    }
+
+    private void validateSubscriptionId(String subscriptionId) {
+        if (subscriptionId == null || subscriptionId.isBlank()) {
+            throw new AccessDeniedException("Realtime subscription id is required.");
+        }
+        if (subscriptionId.length() > MAX_SUBSCRIPTION_ID_LENGTH) {
+            throw new AccessDeniedException("Realtime subscription id is too long.");
+        }
+    }
+
+    private enum SessionState {
+        AUTHENTICATED,
+        CONNECTED
+    }
+}
