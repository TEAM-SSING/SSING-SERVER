@@ -0,0 +1,46 @@
+package org.sopt.ssingserver.domain.matching.config;
+
+import java.time.Duration;
+import org.springframework.boot.context.properties.ConfigurationProperties;
+
+@ConfigurationProperties(prefix = "ssing.matching.search-scheduler")
+public record MatchingSearchSchedulerProperties(
+        Integer batchSize,
+        Duration retryInterval,
+        Duration claimLease
+) {
+
+    private static final int DEFAULT_BATCH_SIZE = 100;
+    private static final int MAX_BATCH_SIZE = 1_000;
+    private static final Duration DEFAULT_RETRY_INTERVAL = Duration.ofMinutes(1);
+    private static final Duration DEFAULT_CLAIM_LEASE = Duration.ofMinutes(10);
+    private static final Duration MAX_RETRY_INTERVAL = Duration.ofDays(1);
+
+    public MatchingSearchSchedulerProperties {
+        batchSize = batchSize == null ? DEFAULT_BATCH_SIZE : batchSize;
+        retryInterval = retryInterval == null ? DEFAULT_RETRY_INTERVAL : retryInterval;
+        claimLease = claimLease == null ? DEFAULT_CLAIM_LEASE : claimLease;
+
+        if (batchSize <= 0 || batchSize > MAX_BATCH_SIZE) {
+            throw new IllegalArgumentException(
+                    "Matching search scheduler batchSize must be between 1 and " + MAX_BATCH_SIZE + "."
+            );
+        }
+        if (retryInterval.isZero()
+                || retryInterval.isNegative()
+                || retryInterval.compareTo(MAX_RETRY_INTERVAL) > 0
+                || retryInterval.toNanos() < 1_000) {
+            throw new IllegalArgumentException(
+                    "Matching search scheduler retryInterval must be between PT0.000001S and PT24H."
+            );
+        }
+        if (claimLease.isZero()
+                || claimLease.isNegative()
+                || claimLease.compareTo(MAX_RETRY_INTERVAL) > 0
+                || claimLease.compareTo(retryInterval) < 0) {
+            throw new IllegalArgumentException(
+                    "Matching search scheduler claimLease must be between retryInterval and PT24H."
+            );
+        }
+    }
+}
