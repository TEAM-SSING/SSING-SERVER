+class RealtimeWebSocketPropertiesTest {
+
+    @Test
+    void 설정이_없으면_wildcard_없이_안전한_기본값을_사용한다() {
+        RealtimeWebSocketProperties properties = defaults();
+
+        assertThat(properties.allowedOrigins()).isEmpty();
+        assertThat(properties.heartbeat().values()).containsExactly(10_000L, 10_000L);
+        assertThat(properties.transport().messageSizeLimitBytes()).isEqualTo(64 * 1024);
+        assertThat(properties.transport().sendTimeLimitMillis()).isEqualTo(10_000);
+        assertThat(properties.transport().sendBufferSizeLimitBytes()).isEqualTo(512 * 1024);
+        assertThat(properties.shouldPreservePublishOrder()).isTrue();
+        assertThat(properties.inboundExecutor().queueCapacity()).isEqualTo(512);
+        assertThat(properties.outboundExecutor().queueWarningThreshold()).isEqualTo(384);
+        assertThat(properties.instanceId()).isEqualTo("local");
+        assertThat(properties.authorization().memberRecheckInterval()).isEqualTo(Duration.ofMinutes(1));
+        assertThat(properties.authorization().lifecycleSchedulerPoolSize()).isEqualTo(2);
+    }
+
+    @Test
+    void allowedOrigins는_blank를_제거하고_외부_변경을_방어한다() {
+        List<String> origins = new ArrayList<>(List.of(
+                " ",
+                "https://app.ssing.test",
+                "https://app.ssing.test",
+                "http://localhost:3000"
+        ));
+        RealtimeWebSocketProperties properties = new RealtimeWebSocketProperties(
+                origins,
+                null,
+                null,
+                null,
+                null,
+                true,
+                "instance-1",
+                Duration.ofMinutes(1),
+                null
+        );
+
+        origins.clear();
+
+        assertThat(properties.allowedOrigins())
+                .containsExactly("https://app.ssing.test", "http://localhost:3000")
+                .isUnmodifiable();
+    }
+
+    @Test
+    void wildcard나_정확한_origin이_아닌_값은_거부한다() {
+        assertThatThrownBy(() -> propertiesWithOrigins(List.of("*")))
+                .isInstanceOf(IllegalArgumentException.class);
+        assertThatThrownBy(() -> propertiesWithOrigins(List.of("https://app.ssing.test/path")))
+                .isInstanceOf(IllegalArgumentException.class);
+        assertThatThrownBy(() -> propertiesWithOrigins(List.of("javascript:alert(1)")))
+                .isInstanceOf(IllegalArgumentException.class);
+    }
+
+    @Test
+    void Spring_int_한계를_넘거나_양수가_아닌_transport는_거부한다() {
+        assertThatThrownBy(() -> new RealtimeWebSocketProperties.Transport(
+                DataSize.ofBytes(0),
+                Duration.ofSeconds(1),
+                DataSize.ofKilobytes(1)
+        )).isInstanceOf(IllegalArgumentException.class);
+        assertThatThrownBy(() -> new RealtimeWebSocketProperties.Transport(
+                DataSize.ofBytes((long) Integer.MAX_VALUE + 1),
+                Duration.ofSeconds(1),
+                DataSize.ofKilobytes(1)
+        )).isInstanceOf(IllegalArgumentException.class);
+        assertThatThrownBy(() -> new RealtimeWebSocketProperties.Transport(
+                DataSize.ofKilobytes(1),
+                Duration.ZERO,
+                DataSize.ofKilobytes(1)
+        )).isInstanceOf(IllegalArgumentException.class);
+    }
+
+    @Test
+    void executor와_instance_id의_안전_경계를_검증한다() {
+        assertThatThrownBy(() -> new RealtimeWebSocketProperties.ChannelExecutor(4, 2, 10, 5))
+                .isInstanceOf(IllegalArgumentException.class);
+        assertThatThrownBy(() -> new RealtimeWebSocketProperties.ChannelExecutor(1, 2, 10, 11))
+                .isInstanceOf(IllegalArgumentException.class);
+        assertThatThrownBy(() -> new RealtimeWebSocketProperties(
+                null,
+                null,
+                null,
+                null,
+                null,
+                true,
+                "instance id with spaces",
+                Duration.ofMinutes(1),
+                null
+        )).isInstanceOf(IllegalArgumentException.class);
+        assertThatThrownBy(() -> new RealtimeWebSocketProperties.Authorization(Duration.ZERO, 1))
+                .isInstanceOf(IllegalArgumentException.class);
+        assertThatThrownBy(() -> new RealtimeWebSocketProperties.Authorization(Duration.ofMinutes(1), 0))
+                .isInstanceOf(IllegalArgumentException.class);
+    }
+
+    private RealtimeWebSocketProperties defaults() {
+        return new RealtimeWebSocketProperties(null, null, null, null, null, null, null, null, null);
+    }
+
+    private RealtimeWebSocketProperties propertiesWithOrigins(List<String> origins) {
+        return new RealtimeWebSocketProperties(origins, null, null, null, null, true, "test", null, null);
+    }
+}
