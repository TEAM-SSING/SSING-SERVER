@@ -0,0 +1,24 @@
+package org.sopt.ssingserver.domain.matching.dto.result;
+
+// 한 번의 재탐색 배치에서 claim한 요청과 실제 처리 결과를 운영 로그에 안전하게 집계
+public record MatchingSearchBatchResult(
+        int claimedCount,
+        int successCount,
+        int failureCount,
+        int skippedCount,
+        long durationMillis
+) {
+
+    public MatchingSearchBatchResult {
+        if (claimedCount < 0
+                || successCount < 0
+                || failureCount < 0
+                || skippedCount < 0
+                || durationMillis < 0) {
+            throw new IllegalArgumentException("Matching search batch counts and duration must not be negative.");
+        }
+        if (successCount + failureCount + skippedCount != claimedCount) {
+            throw new IllegalArgumentException("Matching search batch result counts must equal claimed count.");
+        }
+    }
+}
