+    public static final class RequestLockSqlInspector implements StatementInspector {
+
+        private static final AtomicReference<CountDownLatch> EXPECTED_QUERIES =
+                new AtomicReference<>(new CountDownLatch(0));
+
+        public RequestLockSqlInspector() {
+        }
+
+        static void expectRequestLockQueries(int count) {
+            EXPECTED_QUERIES.set(new CountDownLatch(count));
+        }
+
+        static boolean awaitExpectedQueries(long timeout, TimeUnit timeUnit) throws InterruptedException {
+            return EXPECTED_QUERIES.get().await(timeout, timeUnit);
+        }
+
+        @Override
+        public String inspect(String sql) {
+            String normalizedSql = sql.toLowerCase(Locale.ROOT);
+            if (normalizedSql.contains("matching_requests") && normalizedSql.contains("for update")) {
+                EXPECTED_QUERIES.get().countDown();
+            }
+            return sql;
+        }
+    }
