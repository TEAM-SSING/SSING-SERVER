+	private WebSocketSession connectRawWebSocket(
+			CompletableFuture<String> connectedFrame,
+			CompletableFuture<CloseStatus> closed
+	) throws Exception {
+		StandardWebSocketClient client = new StandardWebSocketClient();
+		WebSocketHttpHeaders headers = new WebSocketHttpHeaders();
+		headers.setSecWebSocketProtocol("v12.stomp");
+		return client.execute(
+				new TextWebSocketHandler() {
+					@Override
+					protected void handleTextMessage(WebSocketSession session, TextMessage message) {
+						if (message.getPayload().startsWith("CONNECTED")) {
+							connectedFrame.complete(message.getPayload());
+						}
+					}
+
+					@Override
+					public void afterConnectionClosed(WebSocketSession session, CloseStatus status) {
+						closed.complete(status);
+					}
+
+					@Override
+					public void handleTransportError(WebSocketSession session, Throwable exception) {
+						if (!session.isOpen() && !closed.isDone()) {
+							closed.completeExceptionally(exception);
+						}
+					}
+				},
+				headers,
+				URI.create("ws://localhost:" + serverPort + "/ws/realtime")
+		).get(5, TimeUnit.SECONDS);
+	}
+
+	private void awaitMatchingSubscription() throws InterruptedException {
+		long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(5);
+		while (System.nanoTime() < deadline) {
+			SimpUser user = simpUserRegistry.getUser("12");
+			if (user != null && user.getSessions().stream()
+					.flatMap(session -> session.getSubscriptions().stream())
+					.anyMatch(subscription -> "/user/queue/matching".equals(subscription.getDestination()))) {
+				return;
+			}
+			Thread.sleep(10);
+		}
+		throw new AssertionError("STOMP matching subscription was not registered within 5 seconds.");
+	}
+
+	private void awaitGauge(String meterName, double expectedValue) throws InterruptedException {
+		long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(5);
+		while (System.nanoTime() < deadline) {
+			double currentValue = meterRegistry.get(meterName).gauge().value();
+			if (Double.compare(currentValue, expectedValue) == 0) {
+				return;
+			}
+			Thread.sleep(10);
+		}
+		throw new AssertionError(meterName + " did not reach " + expectedValue + " within 5 seconds.");
+	}
