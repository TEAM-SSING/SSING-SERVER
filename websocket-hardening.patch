diff --git a/src/test/java/org/sopt/ssingserver/domain/matching/config/MatchingSearchSchedulerLockMySqlIntegrationTest.java b/src/test/java/org/sopt/ssingserver/domain/matching/config/MatchingSearchSchedulerLockMySqlIntegrationTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..9b6cab68b563ffd8ac97509a2380169201651413
--- /dev/null
+++ b/src/test/java/org/sopt/ssingserver/domain/matching/config/MatchingSearchSchedulerLockMySqlIntegrationTest.java
@@ -0,0 +1,140 @@
+package org.sopt.ssingserver.domain.matching.config;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.time.Duration;
+import java.time.Instant;
+import java.util.List;
+import java.util.Optional;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+import java.util.concurrent.TimeUnit;
+import javax.sql.DataSource;
+import net.javacrumbs.shedlock.core.LockConfiguration;
+import net.javacrumbs.shedlock.core.LockProvider;
+import net.javacrumbs.shedlock.core.SimpleLock;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.jdbc.datasource.DriverManagerDataSource;
+import org.testcontainers.containers.MySQLContainer;
+import org.testcontainers.junit.jupiter.Container;
+import org.testcontainers.junit.jupiter.Testcontainers;
+
+@Testcontainers(disabledWithoutDocker = true)
+class MatchingSearchSchedulerLockMySqlIntegrationTest {
+
+    @Container
+    private static final MySQLContainer<?> MYSQL = new MySQLContainer<>("mysql:8.4.8");
+
+    private static JdbcTemplate jdbcTemplate;
+    private static LockProvider firstNodeLockProvider;
+    private static LockProvider secondNodeLockProvider;
+
+    @BeforeAll
+    static void setUpDatabase() {
+        DataSource dataSource = new DriverManagerDataSource(
+                MYSQL.getJdbcUrl(),
+                MYSQL.getUsername(),
+                MYSQL.getPassword()
+        );
+        jdbcTemplate = new JdbcTemplate(dataSource);
+        jdbcTemplate.execute("""
+                CREATE TABLE matching_scheduler_lock (
+                    name VARCHAR(64) NOT NULL,
+                    lock_until TIMESTAMP(3) NOT NULL,
+                    locked_at TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP(3),
+                    locked_by VARCHAR(255) NOT NULL,
+                    PRIMARY KEY (name)
+                )
+                """);
+        firstNodeLockProvider = lockProvider(dataSource);
+        secondNodeLockProvider = lockProvider(dataSource);
+    }
+
+    @BeforeEach
+    void expireExistingLock() {
+        // ShedLock은 존재했던 행을 메모리에 캐시하므로 테스트 사이에도 행을 삭제하지 않고 만료 시각만 옮긴다.
+        jdbcTemplate.update("""
+                UPDATE matching_scheduler_lock
+                SET lock_until = UTC_TIMESTAMP(3) - INTERVAL 1 SECOND,
+                    locked_at = UTC_TIMESTAMP(3) - INTERVAL 1 SECOND,
+                    locked_by = 'test-reset'
+                WHERE name = ?
+                """, MatchingSearchSchedulerConfig.MATCHING_SEARCH_LOCK_NAME);
+    }
+
+    @Test
+    void 같은_작업을_두_노드가_동시에_시도해도_한_노드만_획득한다() throws Exception {
+        ExecutorService executorService = Executors.newFixedThreadPool(2);
+        CountDownLatch ready = new CountDownLatch(2);
+        CountDownLatch start = new CountDownLatch(1);
+
+        try {
+            Future<Optional<SimpleLock>> firstAttempt = executorService.submit(
+                    () -> acquireAfterStartSignal(firstNodeLockProvider, ready, start)
+            );
+            Future<Optional<SimpleLock>> secondAttempt = executorService.submit(
+                    () -> acquireAfterStartSignal(secondNodeLockProvider, ready, start)
+            );
+            assertThat(ready.await(5, TimeUnit.SECONDS)).isTrue();
+            start.countDown();
+
+            List<Optional<SimpleLock>> attempts = List.of(
+                    firstAttempt.get(10, TimeUnit.SECONDS),
+                    secondAttempt.get(10, TimeUnit.SECONDS)
+            );
+
+            assertThat(attempts).filteredOn(Optional::isPresent).hasSize(1);
+            attempts.stream().flatMap(Optional::stream).forEach(SimpleLock::unlock);
+        } finally {
+            start.countDown();
+            executorService.shutdownNow();
+        }
+    }
+
+    @Test
+    void 첫_노드의_락이_만료되면_다른_노드가_작업을_인계한다() {
+        assertThat(firstNodeLockProvider.lock(lockConfiguration())).isPresent();
+        jdbcTemplate.update("""
+                UPDATE matching_scheduler_lock
+                SET lock_until = UTC_TIMESTAMP(3) - INTERVAL 1 SECOND
+                WHERE name = ?
+                """, MatchingSearchSchedulerConfig.MATCHING_SEARCH_LOCK_NAME);
+
+        SimpleLock secondNodeLock = secondNodeLockProvider.lock(lockConfiguration()).orElseThrow();
+
+        assertThat(jdbcTemplate.queryForObject(
+                "SELECT locked_by FROM matching_scheduler_lock WHERE name = ?",
+                String.class,
+                MatchingSearchSchedulerConfig.MATCHING_SEARCH_LOCK_NAME
+        )).isNotBlank();
+        secondNodeLock.unlock();
+    }
+
+    private static LockProvider lockProvider(DataSource dataSource) {
+        return new MatchingSearchSchedulerConfig().matchingSearchLockProvider(dataSource);
+    }
+
+    private static Optional<SimpleLock> acquireAfterStartSignal(
+            LockProvider lockProvider,
+            CountDownLatch ready,
+            CountDownLatch start
+    ) throws InterruptedException {
+        ready.countDown();
+        start.await();
+        return lockProvider.lock(lockConfiguration());
+    }
+
+    private static LockConfiguration lockConfiguration() {
+        return new LockConfiguration(
+                Instant.now(),
+                MatchingSearchSchedulerConfig.MATCHING_SEARCH_LOCK_NAME,
+                Duration.ofSeconds(30),
+                Duration.ZERO
+        );
+    }
+}
