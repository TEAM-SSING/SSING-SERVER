+import org.springframework.scheduling.TaskScheduler;
+import org.springframework.security.access.AccessDeniedException;
+import org.springframework.web.socket.WebSocketSession;
+
+class RealtimeWebSocketSessionRegistryTest {
+
+    private static final Instant NOW = Instant.parse("2026-07-12T00:00:00Z");
+    private static final Instant EXPIRES_AT = NOW.plusSeconds(60);
+
+    private final TaskScheduler taskScheduler = mock(TaskScheduler.class);
+    private final RealtimeWebSocketObservability observability = mock(RealtimeWebSocketObservability.class);
+    private final ScheduledFuture<?> expirationTask = mock(ScheduledFuture.class);
+    private final MutableClock clock = new MutableClock(NOW);
+    private final RealtimeWebSocketSessionRegistry registry = new RealtimeWebSocketSessionRegistry(
+            taskScheduler,
+            clock,
+            observability
+    );
+
+    @BeforeEach
+    void setUp() {
+        doReturn(expirationTask)
+                .when(taskScheduler)
+                .schedule(any(Runnable.class), any(Instant.class));
+    }
+
+    @Test
+    void CONNECT_인증을_만료시각에_묶고_task가_실행되면_실제_transport를_4401로_닫는다()
+            throws IOException {
+        WebSocketSession session = session("session-1");
+        registry.registerTransport(session);
+
+        registry.bindAuthentication("session-1", 12L, MemberRole.CONSUMER, EXPIRES_AT);
+
+        assertThat(registry.authenticatedSessions()).containsExactly(
+                new RealtimeWebSocketSessionRegistry.AuthenticationSnapshot(
+                        "session-1",
+                        12L,
+                        MemberRole.CONSUMER,
+                        EXPIRES_AT
+                )
+        );
+        registry.validateAuthentication(
+                "session-1",
+                new RealtimePrincipal(12L, MemberRole.CONSUMER)
+        );
+        ArgumentCaptor<Runnable> taskCaptor = ArgumentCaptor.forClass(Runnable.class);
+        verify(taskScheduler).schedule(taskCaptor.capture(), org.mockito.ArgumentMatchers.eq(EXPIRES_AT));
+
+        taskCaptor.getValue().run();
+
+        verify(session).close(RealtimeWebSocketTerminationReason.ACCESS_TOKEN_EXPIRED.closeStatus());
+        verify(observability).authorizationTerminationRequested(
+                RealtimeWebSocketTerminationReason.ACCESS_TOKEN_EXPIRED
+        );
+        assertThat(registry.authenticatedSessions()).isEmpty();
+    }
+
+    @Test
+    void 이미_만료된_claim은_예약없이_즉시_종료하고_인증을_거부한다() throws IOException {
+        WebSocketSession session = session("session-1");
+        registry.registerTransport(session);
+
+        assertThatThrownBy(() -> registry.bindAuthentication(
+                "session-1",
+                12L,
+                MemberRole.CONSUMER,
+                NOW
+        )).isInstanceOf(AccessDeniedException.class);
+
+        verify(taskScheduler, never()).schedule(any(Runnable.class), any(Instant.class));
+        verify(session).close(RealtimeWebSocketTerminationReason.ACCESS_TOKEN_EXPIRED.closeStatus());
+    }
+
+    @Test
+    void 만료_task_예약이_거부되면_인증없는_transport로_남기고_fail_closed한다() {
+        WebSocketSession session = session("session-1");
+        registry.registerTransport(session);
+        when(taskScheduler.schedule(any(Runnable.class), any(Instant.class)))
+                .thenThrow(new IllegalStateException("scheduler unavailable"));
+
+        assertThatThrownBy(() -> registry.bindAuthentication(
+                "session-1",
+                12L,
+                MemberRole.CONSUMER,
+                EXPIRES_AT
+        )).isInstanceOf(AccessDeniedException.class);
+
+        assertThat(registry.authenticatedSessions()).isEmpty();
+    }
+
+    @Test
+    void 자연종료는_만료_task와_registry를_정리한다() {
+        WebSocketSession session = session("session-1");
+        registry.registerTransport(session);
+        registry.bindAuthentication("session-1", 12L, MemberRole.CONSUMER, EXPIRES_AT);
+
+        registry.unregisterTransport(session);
+
+        verify(expirationTask).cancel(false);
+        assertThat(registry.registeredTransportCount()).isZero();
+        assertThat(registry.authenticatedSessions()).isEmpty();
+    }
+
+    @Test
+    void 종료된_handle의_오래된_task는_같은_id의_새_session을_닫지_않는다() throws IOException {
+        WebSocketSession oldSession = session("session-1");
+        registry.registerTransport(oldSession);
+        registry.bindAuthentication("session-1", 12L, MemberRole.CONSUMER, EXPIRES_AT);
+        ArgumentCaptor<Runnable> taskCaptor = ArgumentCaptor.forClass(Runnable.class);
+        verify(taskScheduler).schedule(taskCaptor.capture(), org.mockito.ArgumentMatchers.eq(EXPIRES_AT));
+        registry.unregisterTransport(oldSession);
+
+        WebSocketSession newSession = session("session-1");
+        registry.registerTransport(newSession);
+        registry.unregisterTransport(oldSession);
+        taskCaptor.getValue().run();
+
+        verify(oldSession, never()).close(any());
+        verify(newSession, never()).close(any());
+        assertThat(registry.registeredTransportCount()).isEqualTo(1);
+    }
+
+    @Test
+    void 만료와_권한회수가_경합해도_transport_close는_한번만_요청한다() throws IOException {
+        WebSocketSession session = session("session-1");
+        registry.registerTransport(session);
+        registry.bindAuthentication("session-1", 12L, MemberRole.CONSUMER, EXPIRES_AT);
+        ArgumentCaptor<Runnable> taskCaptor = ArgumentCaptor.forClass(Runnable.class);
+        verify(taskScheduler).schedule(taskCaptor.capture(), org.mockito.ArgumentMatchers.eq(EXPIRES_AT));
+
+        assertThat(registry.terminate(
+                "session-1",
+                RealtimeWebSocketTerminationReason.ACCESS_REVOKED
+        )).isTrue();
+        taskCaptor.getValue().run();
+
+        verify(session).close(RealtimeWebSocketTerminationReason.ACCESS_REVOKED.closeStatus());
+        verify(session, never()).close(RealtimeWebSocketTerminationReason.ACCESS_TOKEN_EXPIRED.closeStatus());
+    }
+
+    @Test
+    void transport_close가_실패해도_인증종료는_유지하고_1초뒤_close만_재시도한다()
+            throws IOException {
+        WebSocketSession session = session("session-1");
+        ScheduledFuture<?> retryTask = mock(ScheduledFuture.class);
+        doReturn(expirationTask, retryTask)
+                .when(taskScheduler)
+                .schedule(any(Runnable.class), any(Instant.class));
+        doThrow(new IOException("first close failed"))
+                .doNothing()
+                .when(session)
+                .close(RealtimeWebSocketTerminationReason.ACCESS_TOKEN_EXPIRED.closeStatus());
+        registry.registerTransport(session);
+        registry.bindAuthentication("session-1", 12L, MemberRole.CONSUMER, EXPIRES_AT);
+        ArgumentCaptor<Runnable> expirationCaptor = ArgumentCaptor.forClass(Runnable.class);
+
+        verify(taskScheduler).schedule(
+                expirationCaptor.capture(),
+                org.mockito.ArgumentMatchers.eq(EXPIRES_AT)
+        );
+        expirationCaptor.getValue().run();
+
+        verify(observability).authorizationTerminationFailed(
+                org.mockito.ArgumentMatchers.eq(RealtimeWebSocketTerminationReason.ACCESS_TOKEN_EXPIRED),
+                org.mockito.ArgumentMatchers.any(IOException.class)
+        );
+        assertThat(registry.authenticatedSessions()).isEmpty();
+        assertThatThrownBy(() -> registry.validateAuthentication(
+                "session-1",
+                new RealtimePrincipal(12L, MemberRole.CONSUMER)
+        )).isInstanceOf(AccessDeniedException.class);
+        ArgumentCaptor<Runnable> retryCaptor = ArgumentCaptor.forClass(Runnable.class);
+        verify(taskScheduler).schedule(
+                retryCaptor.capture(),
+                org.mockito.ArgumentMatchers.eq(NOW.plusSeconds(1))
+        );
+
+        retryCaptor.getValue().run();
+
+        verify(session, times(2)).close(
+                RealtimeWebSocketTerminationReason.ACCESS_TOKEN_EXPIRED.closeStatus()
+        );
+        verify(observability).authorizationTerminationRequested(
+                RealtimeWebSocketTerminationReason.ACCESS_TOKEN_EXPIRED
+        );
+        assertThat(registry.authenticatedSessions()).isEmpty();
+    }
+
+    @Test
+    void 권한회수_4403_close_재시도_scheduler가_null이어도_인증종료를_되돌리지_않는다()
+            throws IOException {
+        WebSocketSession session = session("session-1");
+        doThrow(new IOException("close failed"))
+                .when(session)
+                .close(RealtimeWebSocketTerminationReason.ACCESS_REVOKED.closeStatus());
+        AtomicInteger scheduleCallCount = new AtomicInteger();
+        org.mockito.Mockito.doAnswer(invocation -> scheduleCallCount.incrementAndGet() == 1
+                ? expirationTask
+                : null
+        ).when(taskScheduler).schedule(any(Runnable.class), any(Instant.class));
+        registry.registerTransport(session);
+        registry.bindAuthentication("session-1", 12L, MemberRole.CONSUMER, EXPIRES_AT);
+
+        assertThat(registry.terminate(
+                "session-1",
+                RealtimeWebSocketTerminationReason.ACCESS_REVOKED
+        )).isTrue();
+
+        verify(observability).authorizationTerminationRetryRejected(
+                org.mockito.ArgumentMatchers.eq(RealtimeWebSocketTerminationReason.ACCESS_REVOKED),
+                org.mockito.ArgumentMatchers.any(IllegalStateException.class)
+        );
+        assertThat(registry.authenticatedSessions()).isEmpty();
+        assertThatThrownBy(() -> registry.validateAuthentication(
+                "session-1",
+                new RealtimePrincipal(12L, MemberRole.CONSUMER)
+        )).isInstanceOf(AccessDeniedException.class);
+        verify(observability).authorizationTerminationRequested(
+                RealtimeWebSocketTerminationReason.ACCESS_REVOKED
+        );
+    }
+
+    @Test
+    void close는_최대_세번만_시도하고_종료된_인증상태에서_로그폭주를_막는다() throws IOException {
+        WebSocketSession session = session("session-1");
+        ScheduledFuture<?> firstRetry = mock(ScheduledFuture.class);
+        ScheduledFuture<?> secondRetry = mock(ScheduledFuture.class);
+        doReturn(expirationTask, firstRetry, secondRetry)
+                .when(taskScheduler)
+                .schedule(any(Runnable.class), any(Instant.class));
+        doThrow(new IOException("close failed"))
+                .when(session)
+                .close(RealtimeWebSocketTerminationReason.ACCESS_TOKEN_EXPIRED.closeStatus());
+        registry.registerTransport(session);
+        registry.bindAuthentication("session-1", 12L, MemberRole.CONSUMER, EXPIRES_AT);
+        ArgumentCaptor<Runnable> expirationCaptor = ArgumentCaptor.forClass(Runnable.class);
+        verify(taskScheduler).schedule(
+                expirationCaptor.capture(),
+                org.mockito.ArgumentMatchers.eq(EXPIRES_AT)
+        );
+
+        expirationCaptor.getValue().run();
+        ArgumentCaptor<Runnable> firstRetryCaptor = ArgumentCaptor.forClass(Runnable.class);
+        verify(taskScheduler).schedule(
+                firstRetryCaptor.capture(),
+                org.mockito.ArgumentMatchers.eq(NOW.plusSeconds(1))
+        );
+        firstRetryCaptor.getValue().run();
+        ArgumentCaptor<Runnable> secondRetryCaptor = ArgumentCaptor.forClass(Runnable.class);
+        verify(taskScheduler).schedule(
+                secondRetryCaptor.capture(),
+                org.mockito.ArgumentMatchers.eq(NOW.plusSeconds(2))
+        );
+        secondRetryCaptor.getValue().run();
+
+        verify(session, times(3)).close(
+                RealtimeWebSocketTerminationReason.ACCESS_TOKEN_EXPIRED.closeStatus()
+        );
+        verify(observability).authorizationTerminationRetriesExhausted(
+                RealtimeWebSocketTerminationReason.ACCESS_TOKEN_EXPIRED,
+                3
+        );
+        verify(taskScheduler, never()).schedule(
+                any(Runnable.class),
+                org.mockito.ArgumentMatchers.eq(NOW.plusSeconds(4))
+        );
+        assertThat(registry.authenticatedSessions()).isEmpty();
+    }
+
+    @Test
+    void unregister와_close_retry_설치가_경합하면_늦게_반환된_task를_즉시_cancel한다()
+            throws IOException {
+        WebSocketSession session = session("session-1");
+        ScheduledFuture<?> retryTask = mock(ScheduledFuture.class);
+        AtomicInteger scheduleCallCount = new AtomicInteger();
+        org.mockito.Mockito.doAnswer(invocation -> {
+            if (scheduleCallCount.incrementAndGet() == 1) {
+                return expirationTask;
+            }
+            registry.unregisterTransport(session);
+            return retryTask;
+        }).when(taskScheduler).schedule(any(Runnable.class), any(Instant.class));
+        doThrow(new IOException("close failed"))
+                .when(session)
+                .close(RealtimeWebSocketTerminationReason.ACCESS_TOKEN_EXPIRED.closeStatus());
+        registry.registerTransport(session);
+        registry.bindAuthentication("session-1", 12L, MemberRole.CONSUMER, EXPIRES_AT);
+        ArgumentCaptor<Runnable> expirationCaptor = ArgumentCaptor.forClass(Runnable.class);
+        verify(taskScheduler).schedule(
+                expirationCaptor.capture(),
+                org.mockito.ArgumentMatchers.eq(EXPIRES_AT)
+        );
+
+        expirationCaptor.getValue().run();
+
+        verify(retryTask).cancel(false);
+        assertThat(registry.registeredTransportCount()).isZero();
+        assertThat(registry.authenticatedSessions()).isEmpty();
+    }
+
+    @Test
+    void scheduler가_늦어도_현재시각이_exp에_도달한_inbound는_즉시_거부한다() throws IOException {
+        WebSocketSession session = session("session-1");
+        registry.registerTransport(session);
+        registry.bindAuthentication("session-1", 12L, MemberRole.CONSUMER, EXPIRES_AT);
+        clock.setInstant(EXPIRES_AT);
+
+        assertThatThrownBy(() -> registry.validateAuthentication(
+                "session-1",
+                new RealtimePrincipal(12L, MemberRole.CONSUMER)
+        )).isInstanceOf(AccessDeniedException.class);
+
+        verify(session).close(RealtimeWebSocketTerminationReason.ACCESS_TOKEN_EXPIRED.closeStatus());
+        assertThat(registry.authenticatedSessions()).isEmpty();
+    }
+
+    private WebSocketSession session(String sessionId) {
+        WebSocketSession session = mock(WebSocketSession.class);
+        when(session.getId()).thenReturn(sessionId);
+        when(session.isOpen()).thenReturn(true);
+        return session;
+    }
+
+    private static final class MutableClock extends Clock {
+
+        private Instant instant;
+
+        private MutableClock(Instant instant) {
+            this.instant = instant;
+        }
+
+        private void setInstant(Instant instant) {
+            this.instant = instant;
+        }
+
+        @Override
+        public ZoneId getZone() {
+            return ZoneOffset.UTC;
+        }
+
+        @Override
+        public Clock withZone(ZoneId zone) {
+            return Clock.fixed(instant, zone);
+        }
+
+        @Override
+        public Instant instant() {
+            return instant;
+        }
+    }
+}
