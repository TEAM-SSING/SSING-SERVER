+    private Set<String> fieldNames(JsonNode node) {
+        return node.properties().stream()
+                .map(Map.Entry::getKey)
+                .collect(Collectors.toSet());
+    }
+
+    private JsonNode nodeAt(JsonNode root, String path) {
+        JsonNode current = root;
+        for (String fieldName : path.split("\\.")) {
+            current = current.path(fieldName);
+        }
+        return current;
+    }
+
+    private void assertNullableLong(JsonNode root, String fieldName, Long expected) {
+        if (expected == null) {
+            assertThat(root.has(fieldName)).isFalse();
+            return;
+        }
+        assertThat(root.path(fieldName).asLong()).isEqualTo(expected);
+    }
+
+    private void assertNullableEnum(JsonNode root, String fieldName, Enum<?> expected) {
+        if (expected == null) {
+            assertThat(root.has(fieldName)).isFalse();
+            return;
+        }
+        assertThat(root.path(fieldName).asString()).isEqualTo(expected.name());
+    }
+
+    private record MatchingJsonContract(
+            String name,
+            MatchingRealtimeEvent event,
+            Set<String> topLevelFields,
+            Map<String, Set<String>> objectFieldsByPath
+    ) {
+
+        @Override
+        public String toString() {
+            return name;
+        }
     }
