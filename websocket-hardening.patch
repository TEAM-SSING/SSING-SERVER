+package org.sopt.ssingserver.domain.matching.repository;
+
+import java.time.Duration;
+import java.util.List;
+import lombok.RequiredArgsConstructor;
+import org.sopt.ssingserver.domain.matching.enums.MatchingRequestStatus;
+import org.springframework.jdbc.core.namedparam.MapSqlParameterSource;
+import org.springframework.jdbc.core.namedparam.NamedParameterJdbcTemplate;
+import org.springframework.stereotype.Repository;
+import org.springframework.transaction.support.TransactionSynchronizationManager;
+
+@Repository
+@RequiredArgsConstructor
+public class MatchingSearchClaimRepository {
+
+    private static final String CLAIM_DUE_REQUEST_IDS_SQL = """
+            SELECT id
+            FROM matching_requests
+            WHERE status = :status
+              AND search_due_at <= UTC_TIMESTAMP(6)
+            ORDER BY search_due_at, id
+            LIMIT :batchSize
+            FOR UPDATE SKIP LOCKED
+            """;
+
+    private static final String ADVANCE_NEXT_SEARCH_AT_SQL = """
+            UPDATE matching_requests
+            SET next_search_at = TIMESTAMPADD(MICROSECOND, :claimLeaseMicros, UTC_TIMESTAMP(6))
+            WHERE id IN (:ids)
+              AND status = :status
+            """;
+
+    private static final String SCHEDULE_NEXT_RETRY_SQL = """
+            UPDATE matching_requests
+            SET next_search_at = TIMESTAMPADD(MICROSECOND, :retryIntervalMicros, UTC_TIMESTAMP(6))
+            WHERE id = :id
+              AND status = :status
+            """;
+
+    private final NamedParameterJdbcTemplate jdbcTemplate;
+
+    // 조회와 다음 탐색 시각 갱신은 호출자의 짧은 트랜잭션 안에서 함께 완료되어야 한다.
+    public List<Long> claimDueRequestIds(int batchSize, Duration claimLease) {
+        validateArguments(batchSize, claimLease);
+        requireWritableTransaction();
+
+        MapSqlParameterSource selectParameters = new MapSqlParameterSource()
+                .addValue("status", MatchingRequestStatus.REQUESTED.name())
+                .addValue("batchSize", batchSize);
+        List<Long> claimedIds = jdbcTemplate.queryForList(
+                CLAIM_DUE_REQUEST_IDS_SQL,
+                selectParameters,
+                Long.class
+        );
+        if (claimedIds.isEmpty()) {
+            return List.of();
+        }
+
+        MapSqlParameterSource updateParameters = new MapSqlParameterSource()
+                .addValue("ids", claimedIds)
+                .addValue("status", MatchingRequestStatus.REQUESTED.name())
+                .addValue("claimLeaseMicros", claimLease.toNanos() / 1_000);
+        int updatedCount = jdbcTemplate.update(ADVANCE_NEXT_SEARCH_AT_SQL, updateParameters);
+        if (updatedCount != claimedIds.size()) {
+            throw new IllegalStateException("Matching search claim update count did not match selected rows.");
+        }
+
+        return List.copyOf(claimedIds);
+    }
+
+    // 요청 row lock을 보유한 실제 탐색 트랜잭션 안에서 DB 시각 기준 정상 재시도를 예약한다.
+    public void scheduleNextRetry(Long matchingRequestId, Duration retryInterval) {
+        validateDuration(retryInterval, "retryInterval");
+        requireWritableTransaction();
+
+        MapSqlParameterSource parameters = new MapSqlParameterSource()
+                .addValue("id", matchingRequestId)
+                .addValue("status", MatchingRequestStatus.REQUESTED.name())
+                .addValue("retryIntervalMicros", retryInterval.toNanos() / 1_000);
+        int updatedCount = jdbcTemplate.update(SCHEDULE_NEXT_RETRY_SQL, parameters);
+        if (updatedCount != 1) {
+            throw new IllegalStateException("Matching search retry schedule did not update one REQUESTED row.");
+        }
+    }
+
+    private void requireWritableTransaction() {
+        if (!TransactionSynchronizationManager.isActualTransactionActive()
+                || TransactionSynchronizationManager.isCurrentTransactionReadOnly()) {
+            throw new IllegalStateException(
+                    "Matching search claim requires an active writable transaction."
+            );
+        }
+    }
+
+    private void validateArguments(int batchSize, Duration claimLease) {
+        if (batchSize <= 0) {
+            throw new IllegalArgumentException("batchSize must be positive.");
+        }
+        validateDuration(claimLease, "claimLease");
+    }
+
+    private void validateDuration(Duration duration, String name) {
+        if (duration == null
+                || duration.isZero()
+                || duration.isNegative()
+                || duration.toNanos() < 1_000) {
+            throw new IllegalArgumentException(name + " must be at least one microsecond.");
+        }
+    }
+}
