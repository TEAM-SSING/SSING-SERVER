+package org.sopt.ssingserver.global.realtime;
+
+import io.micrometer.core.instrument.Counter;
+import io.micrometer.core.instrument.MeterRegistry;
+import java.util.concurrent.RejectedExecutionException;
+import lombok.RequiredArgsConstructor;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.scheduling.concurrent.ThreadPoolTaskExecutor;
+
+@Configuration
+@RequiredArgsConstructor
+public class RealtimeWebSocketExecutorConfig {
+
+    public static final String INBOUND_EXECUTOR_BEAN = "realtimeClientInboundExecutor";
+    public static final String OUTBOUND_EXECUTOR_BEAN = "realtimeClientOutboundExecutor";
+
+    private static final Logger log = LoggerFactory.getLogger(RealtimeWebSocketExecutorConfig.class);
+
+    private final RealtimeWebSocketProperties properties;
+    private final MeterRegistry meterRegistry;
+
+    @Bean(name = INBOUND_EXECUTOR_BEAN)
+    ThreadPoolTaskExecutor realtimeClientInboundExecutor() {
+        return createExecutor("inbound", properties.inboundExecutor());
+    }
+
+    @Bean(name = OUTBOUND_EXECUTOR_BEAN)
+    ThreadPoolTaskExecutor realtimeClientOutboundExecutor() {
+        return createExecutor("outbound", properties.outboundExecutor());
+    }
+
+    private ThreadPoolTaskExecutor createExecutor(
+            String channel,
+            RealtimeWebSocketProperties.ChannelExecutor settings
+    ) {
+        Counter rejectedCounter = Counter.builder("ssing.realtime.executor.rejected")
+                .description("Rejected realtime STOMP channel tasks")
+                .tag("channel", channel)
+                .tag("instance_id", properties.instanceId())
+                .register(meterRegistry);
+
+        ThreadPoolTaskExecutor executor = new ThreadPoolTaskExecutor();
+        executor.setCorePoolSize(settings.corePoolSize());
+        executor.setMaxPoolSize(settings.maxPoolSize());
+        executor.setQueueCapacity(settings.queueCapacity());
+        executor.setThreadNamePrefix("realtime-ws-" + channel + "-");
+        executor.setRejectedExecutionHandler((task, threadPool) -> {
+            rejectedCounter.increment();
+            log.atWarn()
+                    .addKeyValue("event", "realtime.stomp.executor.rejected")
+                    .addKeyValue("instance_id", properties.instanceId())
+                    .addKeyValue("channel", channel)
+                    .addKeyValue("failure_stage", "executor-submit")
+                    .addKeyValue("active_count", threadPool.getActiveCount())
+                    .addKeyValue("pool_size", threadPool.getPoolSize())
+                    .addKeyValue("queue_size", threadPool.getQueue().size())
+                    .log("Realtime STOMP executor rejected a task");
+            throw new RejectedExecutionException("Realtime STOMP executor capacity exhausted.");
+        });
+        return executor;
+    }
+}
