+    private void givenCandidateLookupWaitsAfterRequestLock(
+            Fixture fixture,
+            AtomicInteger candidateLookupCount,
+            CountDownLatch firstSearchOwnsRequestLock,
+            CountDownLatch releaseFirstSearch
+    ) {
+        when(instructorMatchingSettingRepository.findExposedCandidates(
+                any(Resort.class),
+                eq(Sport.SNOWBOARD),
+                eq(LessonLevel.FIRST_TIME),
+                eq(2),
+                anyCollection(),
+                eq(true)
+        )).thenAnswer(invocation -> {
+            assertThat(TransactionSynchronizationManager.isActualTransactionActive()).isTrue();
+            if (candidateLookupCount.incrementAndGet() == 1) {
+                firstSearchOwnsRequestLock.countDown();
+                awaitOrFail(releaseFirstSearch, "첫 search 해제 신호를 기다리다 시간 초과했습니다.");
+            }
+            return List.of(entityManager.find(InstructorMatchingSetting.class, fixture.matchingSettingId()));
+        });
+        when(instructorMatchingSettingRepository.findExposedCandidateByIdForUpdate(
