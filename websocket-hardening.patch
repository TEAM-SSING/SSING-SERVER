+package org.sopt.ssingserver.global.realtime;
+
+import java.time.Clock;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.stream.Collectors;
+import lombok.RequiredArgsConstructor;
+import org.sopt.ssingserver.domain.member.enums.MemberStatus;
+import org.sopt.ssingserver.global.realtime.RealtimeMemberAuthorizationReader.MemberAuthorizationSnapshot;
+import org.sopt.ssingserver.global.realtime.RealtimeWebSocketSessionRegistry.AuthenticationSnapshot;
+import org.springframework.scheduling.annotation.Scheduled;
+import org.springframework.stereotype.Component;
+
+@Component
+@RequiredArgsConstructor
+public class RealtimeWebSocketAuthorizationMonitor {
+
+    private final RealtimeWebSocketSessionRegistry sessionRegistry;
+    private final RealtimeMemberAuthorizationReader authorizationReader;
+    private final RealtimeWebSocketObservability observability;
+    private final Clock clock;
+
+    @Scheduled(
+            fixedDelayString = "${ssing.realtime.websocket.authorization.member-recheck-interval:PT1M}",
+            scheduler = RealtimeWebSocketLifecycleConfig.LIFECYCLE_SCHEDULER_BEAN
+    )
+    public void revalidateActiveSessions() {
+        long startedAt = System.nanoTime();
+        List<AuthenticationSnapshot> snapshots = sessionRegistry.authenticatedSessions();
+        if (snapshots.isEmpty()) {
+            return;
+        }
+
+        int expiredTerminationRequestedCount = terminateExpiredSessions(snapshots);
+        List<AuthenticationSnapshot> currentSnapshots = snapshots.stream()
+                .filter(snapshot -> snapshot.expiresAt().isAfter(clock.instant()))
+                .toList();
+        if (currentSnapshots.isEmpty()) {
+            observability.authorizationRecheckSucceeded(
+                    snapshots.size(),
+                    0,
+                    expiredTerminationRequestedCount,
+                    System.nanoTime() - startedAt
+            );
+            return;
+        }
+
+        Set<Long> memberIds = currentSnapshots.stream()
+                .map(AuthenticationSnapshot::memberId)
+                .collect(Collectors.toUnmodifiableSet());
+        Map<Long, MemberAuthorizationSnapshot> members;
+        try {
+            members = authorizationReader.findAll(memberIds);
+        } catch (RuntimeException exception) {
+            // 기존 연결은 유지해 DB 장애 때 재연결 폭주를 만들지 않고, 다음 주기에 다시 확인한다.
+            observability.authorizationRecheckFailed(
+                    currentSnapshots.size(),
+                    memberIds.size(),
+                    exception,
+                    System.nanoTime() - startedAt
+            );
+            return;
+        }
+
+        int terminationRequestedSessionCount = expiredTerminationRequestedCount;
+        for (AuthenticationSnapshot snapshot : currentSnapshots) {
+            MemberAuthorizationSnapshot member = members.get(snapshot.memberId());
+            if (member == null
+                    || member.status() != MemberStatus.ACTIVE) {
+                if (sessionRegistry.terminate(
+                        snapshot.sessionId(),
+                        RealtimeWebSocketTerminationReason.ACCESS_REVOKED
+                )) {
+                    terminationRequestedSessionCount++;
+                }
+            } else if (member.role() != snapshot.role()
+                    && sessionRegistry.terminate(
+                    snapshot.sessionId(),
+                    RealtimeWebSocketTerminationReason.AUTH_CONTEXT_CHANGED
+            )) {
+                terminationRequestedSessionCount++;
+            }
+        }
+        observability.authorizationRecheckSucceeded(
+                snapshots.size(),
+                memberIds.size(),
+                terminationRequestedSessionCount,
+                System.nanoTime() - startedAt
+        );
+    }
+
+    private int terminateExpiredSessions(List<AuthenticationSnapshot> snapshots) {
+        int terminated = 0;
+        for (AuthenticationSnapshot snapshot : snapshots) {
+            if (!snapshot.expiresAt().isAfter(clock.instant())
+                    && sessionRegistry.terminate(
+                    snapshot.sessionId(),
+                    RealtimeWebSocketTerminationReason.ACCESS_TOKEN_EXPIRED
+            )) {
+                terminated++;
+            }
+        }
+        return terminated;
+    }
+}
