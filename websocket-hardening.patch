+    @Test
+    void 인증수명_log와_metric은_종료이유만_남기고_예외_message를_남기지_않는다() {
+        Fixture fixture = fixture();
+        Logger logger = (Logger) LoggerFactory.getLogger(RealtimeWebSocketObservability.class);
+        ListAppender<ILoggingEvent> appender = new ListAppender<>();
+        appender.start();
+        logger.addAppender(appender);
+
+        try {
+            fixture.observability().authorizationTerminationRequested(
+                    RealtimeWebSocketTerminationReason.ACCESS_TOKEN_EXPIRED
+            );
+            fixture.observability().authorizationTerminationFailed(
+                    RealtimeWebSocketTerminationReason.ACCESS_TOKEN_EXPIRED,
+                    new IllegalStateException("Bearer secret-token raw-session-id")
