@@ -0,0 +1,321 @@
+package org.sopt.ssingserver.global.realtime;
+
+import java.io.IOException;
+import java.time.Clock;
+import java.time.Duration;
+import java.time.Instant;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.ScheduledFuture;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicReference;
+import org.sopt.ssingserver.domain.member.enums.MemberRole;
+import org.springframework.beans.factory.annotation.Qualifier;
+import org.springframework.scheduling.TaskScheduler;
+import org.springframework.security.access.AccessDeniedException;
+import org.springframework.stereotype.Component;
+import org.springframework.web.socket.WebSocketSession;
+
+@Component
+public class RealtimeWebSocketSessionRegistry {
+
+    private static final Duration CLOSE_RETRY_DELAY = Duration.ofSeconds(1);
+    private static final int MAX_CLOSE_ATTEMPTS = 3;
+
+    private final Map<String, SessionHandle> sessions = new ConcurrentHashMap<>();
+    private final TaskScheduler lifecycleTaskScheduler;
+    private final Clock clock;
+    private final RealtimeWebSocketObservability observability;
+
+    public RealtimeWebSocketSessionRegistry(
+            @Qualifier(RealtimeWebSocketLifecycleConfig.LIFECYCLE_SCHEDULER_BEAN)
+            TaskScheduler lifecycleTaskScheduler,
+            Clock clock,
+            RealtimeWebSocketObservability observability
+    ) {
+        this.lifecycleTaskScheduler = lifecycleTaskScheduler;
+        this.clock = clock;
+        this.observability = observability;
+    }
+
+    public void registerTransport(WebSocketSession transportSession) {
+        Objects.requireNonNull(transportSession, "transportSession must not be null");
+        String sessionId = requireSessionId(transportSession.getId());
+        SessionHandle newHandle = new SessionHandle(sessionId, transportSession);
+        if (sessions.putIfAbsent(sessionId, newHandle) != null) {
+            throw new IllegalStateException("Realtime transport session is already registered.");
+        }
+    }
+
+    public void unregisterTransport(WebSocketSession transportSession) {
+        if (transportSession == null) {
+            return;
+        }
+        String sessionId = transportSession.getId();
+        if (sessionId == null || sessionId.isBlank()) {
+            return;
+        }
+        SessionHandle current = sessions.get(sessionId);
+        if (current != null
+                && current.transportSession == transportSession
+                && sessions.remove(sessionId, current)) {
+            current.markClosed();
+        }
+    }
+
+    public void bindAuthentication(
+            String sessionId,
+            Long memberId,
+            MemberRole role,
+            Instant expiresAt
+    ) {
+        SessionHandle handle = requireCurrentHandle(sessionId);
+        if (memberId == null || role == null || expiresAt == null) {
+            terminate(handle, RealtimeWebSocketTerminationReason.ACCESS_TOKEN_EXPIRED);
+            throw new AccessDeniedException("Realtime authentication claims are incomplete.");
+        }
+        if (!expiresAt.isAfter(clock.instant())) {
+            terminate(handle, RealtimeWebSocketTerminationReason.ACCESS_TOKEN_EXPIRED);
+            throw new AccessDeniedException("Realtime access token is expired.");
+        }
+
+        AuthenticationSnapshot snapshot = new AuthenticationSnapshot(sessionId, memberId, role, expiresAt);
+        synchronized (handle) {
+            ensureBindable(handle);
+            handle.authentication = snapshot;
+            ScheduledFuture<?> expirationTask;
+            try {
+                expirationTask = lifecycleTaskScheduler.schedule(
+                        () -> terminate(handle, RealtimeWebSocketTerminationReason.ACCESS_TOKEN_EXPIRED),
+                        expiresAt
+                );
+            } catch (RuntimeException exception) {
+                handle.authentication = null;
+                throw new AccessDeniedException(
+                        "Realtime access token expiration could not be scheduled.",
+                        exception
+                );
+            }
+            if (expirationTask == null) {
+                handle.authentication = null;
+                throw new AccessDeniedException("Realtime access token expiration could not be scheduled.");
+            }
+            handle.expirationTask = expirationTask;
+            if (sessions.get(handle.sessionId) != handle
+                    || handle.terminationReason.get() != null
+                    || handle.transportClosed) {
+                expirationTask.cancel(false);
+                handle.authentication = null;
+                throw new AccessDeniedException("Realtime session is closing.");
+            }
+        }
+    }
+
+    public void validateAuthentication(
+            String sessionId,
+            RealtimePrincipal principal
+    ) {
+        SessionHandle handle = requireCurrentHandle(sessionId);
+        AuthenticationSnapshot snapshot = handle.authentication;
+        if (snapshot == null
+                || handle.terminationReason.get() != null
+                || handle.transportClosed
+                || !snapshot.memberId().equals(principal.memberId())
+                || snapshot.role() != principal.role()) {
+            throw new AccessDeniedException("Realtime session authentication is invalid.");
+        }
+        if (!snapshot.expiresAt().isAfter(clock.instant())) {
+            terminate(handle, RealtimeWebSocketTerminationReason.ACCESS_TOKEN_EXPIRED);
+            throw new AccessDeniedException("Realtime access token is expired.");
+        }
+    }
+
+    public List<AuthenticationSnapshot> authenticatedSessions() {
+        return sessions.values().stream()
+                .filter(handle -> handle.terminationReason.get() == null)
+                .filter(handle -> !handle.transportClosed)
+                .map(handle -> handle.authentication)
+                .filter(Objects::nonNull)
+                .toList();
+    }
+
+    public boolean terminate(
+            String sessionId,
+            RealtimeWebSocketTerminationReason reason
+    ) {
+        SessionHandle handle = sessions.get(sessionId);
+        return handle != null && terminate(handle, reason);
+    }
+
+    int registeredTransportCount() {
+        return sessions.size();
+    }
+
+    private boolean terminate(
+            SessionHandle handle,
+            RealtimeWebSocketTerminationReason reason
+    ) {
+        if (sessions.get(handle.sessionId) != handle
+                || !handle.terminationReason.compareAndSet(null, reason)) {
+            return false;
+        }
+
+        handle.cancelExpirationTask();
+        observability.authorizationTerminationRequested(reason);
+        attemptClose(handle);
+        return true;
+    }
+
+    private void attemptClose(SessionHandle handle) {
+        RealtimeWebSocketTerminationReason reason = handle.terminationReason.get();
+        if (reason == null
+                || sessions.get(handle.sessionId) != handle
+                || handle.transportClosed
+                || !handle.closeAttemptInProgress.compareAndSet(false, true)) {
+            return;
+        }
+
+        int closeAttempt = handle.closeAttemptCount.incrementAndGet();
+        try {
+            handle.transportSession.close(reason.closeStatus());
+        } catch (IOException | RuntimeException exception) {
+            observability.authorizationTerminationFailed(reason, exception);
+            // scheduler 등록이 지연돼도 retry task가 이전 close 시도 상태에 막히지 않게 먼저 해제한다.
+            handle.closeAttemptInProgress.set(false);
+            if (closeAttempt < MAX_CLOSE_ATTEMPTS) {
+                scheduleCloseRetry(handle, reason, closeAttempt);
+            } else {
+                observability.authorizationTerminationRetriesExhausted(reason, closeAttempt);
+            }
+        } finally {
+            handle.closeAttemptInProgress.set(false);
+        }
+    }
+
+    private void scheduleCloseRetry(
+            SessionHandle handle,
+            RealtimeWebSocketTerminationReason reason,
+            int completedAttemptCount
+    ) {
+        if (sessions.get(handle.sessionId) != handle || handle.transportClosed) {
+            return;
+        }
+        try {
+            Duration retryDelay = CLOSE_RETRY_DELAY.multipliedBy(1L << (completedAttemptCount - 1));
+            ScheduledFuture<?> retryTask = lifecycleTaskScheduler.schedule(
+                    () -> {
+                        handle.clearCloseRetryTask();
+                        attemptClose(handle);
+                    },
+                    clock.instant().plus(retryDelay)
+            );
+            if (retryTask == null) {
+                observability.authorizationTerminationRetryRejected(
+                        reason,
+                        new IllegalStateException("Realtime close retry scheduling returned no task.")
+                );
+                return;
+            }
+            if (!handle.installCloseRetryTask(retryTask)) {
+                retryTask.cancel(false);
+            }
+        } catch (RuntimeException exception) {
+            observability.authorizationTerminationRetryRejected(reason, exception);
+        }
+    }
+
+    private SessionHandle requireCurrentHandle(String sessionId) {
+        String requiredSessionId = requireSessionId(sessionId);
+        SessionHandle handle = sessions.get(requiredSessionId);
+        if (handle == null) {
+            throw new AccessDeniedException("Realtime transport session is not registered.");
+        }
+        return handle;
+    }
+
+    private String requireSessionId(String sessionId) {
+        if (sessionId == null || sessionId.isBlank()) {
+            throw new AccessDeniedException("Realtime session id is required.");
+        }
+        return sessionId;
+    }
+
+    private void ensureBindable(SessionHandle handle) {
+        if (sessions.get(handle.sessionId) != handle
+                || handle.terminationReason.get() != null
+                || handle.transportClosed
+                || !handle.transportSession.isOpen()) {
+            throw new AccessDeniedException("Realtime transport session is not active.");
+        }
+        if (handle.authentication != null) {
+            throw new AccessDeniedException("Realtime session is already authenticated.");
+        }
+    }
+
+    public record AuthenticationSnapshot(
+            String sessionId,
+            Long memberId,
+            MemberRole role,
+            Instant expiresAt
+    ) {
+    }
+
+    private static final class SessionHandle {
+
+        private final String sessionId;
+        private final WebSocketSession transportSession;
+        private final AtomicReference<RealtimeWebSocketTerminationReason> terminationReason =
+                new AtomicReference<>();
+        private final AtomicBoolean closeAttemptInProgress = new AtomicBoolean();
+        private final AtomicInteger closeAttemptCount = new AtomicInteger();
+        private volatile AuthenticationSnapshot authentication;
+        private volatile ScheduledFuture<?> expirationTask;
+        private volatile ScheduledFuture<?> closeRetryTask;
+        private volatile boolean transportClosed;
+
+        private SessionHandle(
+                String sessionId,
+                WebSocketSession transportSession
+        ) {
+            this.sessionId = sessionId;
+            this.transportSession = transportSession;
+        }
+
+        private synchronized void cancelExpirationTask() {
+            ScheduledFuture<?> task = expirationTask;
+            expirationTask = null;
+            if (task != null) {
+                task.cancel(false);
+            }
+        }
+
+        private synchronized boolean installCloseRetryTask(ScheduledFuture<?> retryTask) {
+            if (transportClosed || terminationReason.get() == null) {
+                return false;
+            }
+            if (closeRetryTask != null) {
+                return false;
+            }
+            closeRetryTask = retryTask;
+            return true;
+        }
+
+        private synchronized void clearCloseRetryTask() {
+            closeRetryTask = null;
+        }
+
+        private synchronized void markClosed() {
+            transportClosed = true;
+            cancelExpirationTask();
+            ScheduledFuture<?> retryTask = closeRetryTask;
+            closeRetryTask = null;
+            if (retryTask != null) {
+                retryTask.cancel(false);
+            }
+            authentication = null;
+        }
+    }
+}
