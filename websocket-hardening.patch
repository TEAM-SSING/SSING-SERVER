+package org.sopt.ssingserver.global.realtime;
+
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.scheduling.TaskScheduler;
+import org.springframework.scheduling.concurrent.ThreadPoolTaskScheduler;
+
+@Configuration
+public class RealtimeWebSocketLifecycleConfig {
+
+    public static final String LIFECYCLE_SCHEDULER_BEAN = "realtimeWebSocketLifecycleTaskScheduler";
+
+    @Bean(name = LIFECYCLE_SCHEDULER_BEAN)
+    TaskScheduler realtimeWebSocketLifecycleTaskScheduler(
+            RealtimeWebSocketProperties properties
+    ) {
+        ThreadPoolTaskScheduler scheduler = new ThreadPoolTaskScheduler();
+        scheduler.setPoolSize(properties.authorization().lifecycleSchedulerPoolSize());
+        scheduler.setThreadNamePrefix("realtime-ws-lifecycle-");
+        scheduler.setRemoveOnCancelPolicy(true);
+        return scheduler;
+    }
+}
