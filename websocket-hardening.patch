@@ -0,0 +1,27 @@
+package org.sopt.ssingserver.global.realtime;
+
+import org.springframework.web.socket.CloseStatus;
+
+public enum RealtimeWebSocketTerminationReason {
+
+    ACCESS_TOKEN_EXPIRED(4401, "AUTH_TOKEN_EXPIRED"),
+    ACCESS_REVOKED(4403, "REALTIME_ACCESS_REVOKED"),
+    AUTH_CONTEXT_CHANGED(4409, "AUTH_CONTEXT_CHANGED");
+
+    private final CloseStatus closeStatus;
+
+    RealtimeWebSocketTerminationReason(
+            int closeCode,
+            String reason
+    ) {
+        this.closeStatus = new CloseStatus(closeCode, reason);
+    }
+
+    public CloseStatus closeStatus() {
+        return closeStatus;
+    }
+
+    public String metricValue() {
+        return name().toLowerCase();
+    }
+}
