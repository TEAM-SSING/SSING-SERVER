+package org.sopt.ssingserver.global.realtime;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import java.util.List;
+import java.util.Set;
+import org.junit.jupiter.api.Test;
+import org.sopt.ssingserver.domain.member.entity.Member;
+import org.sopt.ssingserver.domain.member.enums.MemberRole;
+import org.sopt.ssingserver.domain.member.enums.MemberStatus;
+import org.sopt.ssingserver.domain.member.repository.MemberRepository;
+
+class RealtimeMemberAuthorizationReaderTest {
+
+    private final MemberRepository memberRepository = mock(MemberRepository.class);
+    private final RealtimeMemberAuthorizationReader reader =
+            new RealtimeMemberAuthorizationReader(memberRepository);
+
+    @Test
+    void session수가_아니라_distinct_member_id를_한번의_bulk_query로_조회한다() {
+        Member active = member(12L, MemberRole.CONSUMER, MemberStatus.ACTIVE);
+        Member suspended = member(34L, MemberRole.INSTRUCTOR, MemberStatus.SUSPENDED);
+        Set<Long> memberIds = Set.of(12L, 34L);
+        when(memberRepository.findAllById(memberIds)).thenReturn(List.of(active, suspended));
+
+        var result = reader.findAll(memberIds);
+
+        assertThat(result)
+                .containsEntry(
+                        12L,
+                        new RealtimeMemberAuthorizationReader.MemberAuthorizationSnapshot(
+                                12L,
+                                MemberRole.CONSUMER,
+                                MemberStatus.ACTIVE
+                        )
+                )
+                .containsEntry(
+                        34L,
+                        new RealtimeMemberAuthorizationReader.MemberAuthorizationSnapshot(
+                                34L,
+                                MemberRole.INSTRUCTOR,
+                                MemberStatus.SUSPENDED
+                        )
+                );
+        verify(memberRepository).findAllById(memberIds);
+    }
+
+    private Member member(
+            Long memberId,
+            MemberRole role,
+            MemberStatus status
+    ) {
+        Member member = mock(Member.class);
+        when(member.getId()).thenReturn(memberId);
+        when(member.getRole()).thenReturn(role);
+        when(member.getStatus()).thenReturn(status);
+        return member;
+    }
+}
