@@ -0,0 +1,69 @@
+package org.sopt.ssingserver.global.realtime;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import io.micrometer.core.instrument.simple.SimpleMeterRegistry;
+import java.time.Duration;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.RejectedExecutionException;
+import java.util.concurrent.TimeUnit;
+import org.junit.jupiter.api.Test;
+import org.springframework.scheduling.concurrent.ThreadPoolTaskExecutor;
+
+class RealtimeWebSocketExecutorConfigTest {
+
+    @Test
+    void inbound_executor는_유한_pool과_queue를_사용하고_포화시_거부를_계수한다() throws Exception {
+        SimpleMeterRegistry meterRegistry = new SimpleMeterRegistry();
+        RealtimeWebSocketProperties properties = properties();
+        RealtimeWebSocketExecutorConfig config = new RealtimeWebSocketExecutorConfig(properties, meterRegistry);
+        ThreadPoolTaskExecutor executor = config.realtimeClientInboundExecutor();
+        executor.initialize();
+        CountDownLatch runningTask = new CountDownLatch(1);
+        CountDownLatch releaseTask = new CountDownLatch(1);
+
+        try {
+            executor.execute(() -> {
+                runningTask.countDown();
+                try {
+                    releaseTask.await();
+                } catch (InterruptedException exception) {
+                    Thread.currentThread().interrupt();
+                }
+            });
+            assertThat(runningTask.await(5, TimeUnit.SECONDS)).isTrue();
+            executor.execute(() -> { });
+
+            assertThatThrownBy(() -> executor.execute(() -> { }))
+                    .isInstanceOf(RejectedExecutionException.class);
+            assertThat(executor.getCorePoolSize()).isEqualTo(1);
+            assertThat(executor.getMaxPoolSize()).isEqualTo(1);
+            assertThat(executor.getQueueCapacity()).isEqualTo(1);
+            assertThat(meterRegistry.counter(
+                    "ssing.realtime.executor.rejected",
+                    "channel", "inbound",
+                    "instance_id", "test"
+            ).count()).isEqualTo(1);
+        } finally {
+            releaseTask.countDown();
+            executor.shutdown();
+        }
+    }
+
+    private RealtimeWebSocketProperties properties() {
+        RealtimeWebSocketProperties.ChannelExecutor executor =
+                new RealtimeWebSocketProperties.ChannelExecutor(1, 1, 1, 1);
+        return new RealtimeWebSocketProperties(
+                null,
+                null,
+                null,
+                executor,
+                executor,
+                true,
+                "test",
+                Duration.ofHours(1),
+                null
+        );
+    }
+}
