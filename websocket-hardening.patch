+                eq(Sport.SNOWBOARD),
+                eq(LessonLevel.FIRST_TIME),
+                eq(2),
+                anyCollection(),
+                eq(true)
+        )).thenAnswer(invocation -> Optional.of(
+                entityManager.find(InstructorMatchingSetting.class, fixture.matchingSettingId())
+        ));
+    }
