+					@Override
+					public void afterConnected(StompSession session, StompHeaders headers) {
+						connectedHeaders.complete(headers);
+					}
+
+					@Override
+					public void handleTransportError(StompSession session, Throwable exception) {
+						connectedHeaders.completeExceptionally(exception);
+					}
+				}
+		);
+	}
+
+	private StompClientResources newStompClient() {
+		ThreadPoolTaskScheduler scheduler = new ThreadPoolTaskScheduler();
+		scheduler.setPoolSize(1);
+		scheduler.setThreadNamePrefix("stomp-integration-test-");
+		scheduler.initialize();
+
+		WebSocketStompClient client = new WebSocketStompClient(new StandardWebSocketClient());
+		client.setMessageConverter(new StringMessageConverter());
+		client.setTaskScheduler(scheduler);
+		client.setDefaultHeartbeat(new long[]{1_000L, 1_000L});
+		return new StompClientResources(client, scheduler);
+	}
+
+	private record StompClientResources(
+			WebSocketStompClient client,
+			ThreadPoolTaskScheduler scheduler
+	) implements AutoCloseable {
+
+		@Override
+		public void close() {
+			client.stop();
+			scheduler.shutdown();
+		}
+	}
+
 }
