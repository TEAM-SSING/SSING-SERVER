diff --git a/src/test/java/org/sopt/ssingserver/global/realtime/RealtimeStompSubscriptionLimiterTest.java b/src/test/java/org/sopt/ssingserver/global/realtime/RealtimeStompSubscriptionLimiterTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..89890f02068e8f16c77cccc28157add51b53dc94
--- /dev/null
+++ b/src/test/java/org/sopt/ssingserver/global/realtime/RealtimeStompSubscriptionLimiterTest.java
@@ -0,0 +1,156 @@
+package org.sopt.ssingserver.global.realtime;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+import java.util.concurrent.TimeUnit;
+import org.junit.jupiter.api.Test;
+import org.springframework.security.access.AccessDeniedException;
+
+class RealtimeStompSubscriptionLimiterTest {
+
+    private final RealtimeStompSubscriptionLimiter limiter = new RealtimeStompSubscriptionLimiter();
+
+    @Test
+    void 한_session은_matching과_lesson을_각각_한번만_구독한다() {
+        connectSession("session-1");
+
+        limiter.reserve("session-1", "matching-1", "/user/queue/matching");
+        limiter.reserve("session-1", "lesson-1", "/user/queue/lesson");
+
+        assertThat(limiter.sessionSubscriptionCount("session-1")).isEqualTo(2);
+        assertThat(limiter.activeSubscriptionCount()).isEqualTo(2);
+        assertThatThrownBy(() -> limiter.reserve(
+                "session-1", "matching-2", "/user/queue/matching"
+        )).isInstanceOf(AccessDeniedException.class);
+    }
+
+    @Test
+    void 종료되었거나_연결되지_않은_session은_구독을_새로_만들지_못한다() {
+        assertThatThrownBy(() -> limiter.reserve(
+                "session-1", "matching-1", "/user/queue/matching"
+        )).isInstanceOf(AccessDeniedException.class);
+
+        connectSession("session-1");
+        limiter.reserve("session-1", "matching-1", "/user/queue/matching");
+        limiter.clearSession("session-1");
+
+        assertThatThrownBy(() -> limiter.reserve(
+                "session-1", "matching-2", "/user/queue/matching"
+        )).isInstanceOf(AccessDeniedException.class);
+        assertThat(limiter.activeSubscriptionCount()).isZero();
+        assertThat(limiter.sessionSubscriptionCount("session-1")).isZero();
+    }
+
+    @Test
+    void subscription_id는_길이를_제한한다() {
+        connectSession("session-1");
+
+        assertThatThrownBy(() -> limiter.reserve(
+                "session-1", "a".repeat(129), "/user/queue/matching"
+        )).isInstanceOf(AccessDeniedException.class);
+    }
+
+    @Test
+    void disconnect와_unsubscribe가_경합해도_count는_음수가_되지_않는다() throws Exception {
+        connectSession("session-1");
+        limiter.reserve("session-1", "matching-1", "/user/queue/matching");
+        CountDownLatch start = new CountDownLatch(1);
+        ExecutorService executor = Executors.newFixedThreadPool(2);
+
+        try {
+            Future<?> disconnect = executor.submit(() -> {
+                await(start);
+                limiter.clearSession("session-1");
+            });
+            Future<?> unsubscribe = executor.submit(() -> {
+                await(start);
+                limiter.release("session-1", "matching-1");
+            });
+            start.countDown();
+            disconnect.get(5, TimeUnit.SECONDS);
+            unsubscribe.get(5, TimeUnit.SECONDS);
+
+            assertThat(limiter.activeSubscriptionCount()).isZero();
+            assertThat(limiter.sessionSubscriptionCount("session-1")).isZero();
+        } finally {
+            executor.shutdownNow();
+        }
+    }
+
+    @Test
+    void 종료된_session은_늦은_connected_event가_와도_다시_활성화되지_않는다() {
+        limiter.markAuthenticated("session-1");
+        limiter.clearSession("session-1");
+
+        assertThat(limiter.markConnected("session-1")).isFalse();
+        assertThat(limiter.connectedSessionCount()).isZero();
+        assertThatThrownBy(() -> limiter.reserve(
+                "session-1", "matching-1", "/user/queue/matching"
+        )).isInstanceOf(AccessDeniedException.class);
+        assertThatThrownBy(() -> limiter.markAuthenticated("session-1"))
+                .isInstanceOf(AccessDeniedException.class);
+    }
+
+    @Test
+    void disconnect와_subscribe가_경합해도_종료후_구독은_남지_않는다() throws Exception {
+        connectSession("session-1");
+        CountDownLatch start = new CountDownLatch(1);
+        ExecutorService executor = Executors.newFixedThreadPool(2);
+
+        try {
+            Future<?> disconnect = executor.submit(() -> {
+                await(start);
+                limiter.clearSession("session-1");
+            });
+            Future<?> subscribe = executor.submit(() -> {
+                await(start);
+                try {
+                    limiter.reserve("session-1", "matching-1", "/user/queue/matching");
+                } catch (AccessDeniedException ignored) {
+                    // disconnect가 먼저 상태를 CLOSED로 만들면 새 구독은 의도대로 거부된다.
+                }
+            });
+            start.countDown();
+            disconnect.get(5, TimeUnit.SECONDS);
+            subscribe.get(5, TimeUnit.SECONDS);
+
+            assertThat(limiter.connectedSessionCount()).isZero();
+            assertThat(limiter.activeSubscriptionCount()).isZero();
+            assertThat(limiter.sessionSubscriptionCount("session-1")).isZero();
+        } finally {
+            executor.shutdownNow();
+        }
+    }
+
+    @Test
+    void 종료_session_tombstone은_최근_10000개로_제한한다() {
+        for (int index = 0; index <= 10_000; index++) {
+            limiter.clearSession("closed-session-" + index);
+        }
+
+        limiter.markAuthenticated("closed-session-0");
+        assertThatThrownBy(() -> limiter.markAuthenticated("closed-session-1"))
+                .isInstanceOf(AccessDeniedException.class);
+        assertThatThrownBy(() -> limiter.markAuthenticated("closed-session-10000"))
+                .isInstanceOf(AccessDeniedException.class);
+    }
+
+    private void connectSession(String sessionId) {
+        limiter.markAuthenticated(sessionId);
+        assertThat(limiter.markConnected(sessionId)).isTrue();
+    }
+
+    private void await(CountDownLatch latch) {
+        try {
+            latch.await();
+        } catch (InterruptedException exception) {
+            Thread.currentThread().interrupt();
+            throw new IllegalStateException(exception);
+        }
+    }
+}
