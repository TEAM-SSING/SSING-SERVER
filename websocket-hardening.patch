+        AtomicInteger matchingCallbacks = new AtomicInteger();
+        AtomicInteger lessonCallbacks = new AtomicInteger();
+
+        transactionTemplate.executeWithoutResult(status -> {
+            jdbcTemplate.update(
+                    "INSERT INTO realtime_after_commit_probe(id, marker) VALUES (?, ?)",
+                    1L,
+                    "commit"
+            );
+            matchingExecutor.execute("matching-test", matchingCallbacks::incrementAndGet);
+            lessonExecutor.execute("lesson-test", lessonCallbacks::incrementAndGet);
+
+            assertThat(matchingCallbacks).hasValue(0);
+            assertThat(lessonCallbacks).hasValue(0);
+        });
+
+        assertThat(jdbcTemplate.queryForObject(
+                "SELECT COUNT(*) FROM realtime_after_commit_probe WHERE id = 1",
+                Integer.class
+        )).isEqualTo(1);
+        assertThat(matchingCallbacks).hasValue(1);
+        assertThat(lessonCallbacks).hasValue(1);
+    }
+
+    @Test
+    void 실제_DB_rollback이면_matching과_lesson_callback을_실행하지_않는다() {
+        AtomicInteger matchingCallbacks = new AtomicInteger();
+        AtomicInteger lessonCallbacks = new AtomicInteger();
+
+        assertThatThrownBy(() -> transactionTemplate.executeWithoutResult(status -> {
+            jdbcTemplate.update(
+                    "INSERT INTO realtime_after_commit_probe(id, marker) VALUES (?, ?)",
+                    2L,
+                    "rollback"
+            );
+            matchingExecutor.execute("matching-test", matchingCallbacks::incrementAndGet);
+            lessonExecutor.execute("lesson-test", lessonCallbacks::incrementAndGet);
+            throw new RollbackProbeException();
+        })).isInstanceOf(RollbackProbeException.class);
+
+        assertThat(jdbcTemplate.queryForObject(
+                "SELECT COUNT(*) FROM realtime_after_commit_probe WHERE id = 2",
+                Integer.class
+        )).isZero();
+        assertThat(matchingCallbacks).hasValue(0);
+        assertThat(lessonCallbacks).hasValue(0);
+    }
+
+    @Test
+    void commit후_callback_하나가_실패해도_DB와_다음_callback은_유지한다() {
+        AtomicInteger nextCallbacks = new AtomicInteger();
+
+        transactionTemplate.executeWithoutResult(status -> {
+            jdbcTemplate.update(
+                    "INSERT INTO realtime_after_commit_probe(id, marker) VALUES (?, ?)",
+                    3L,
+                    "callback-failure"
+            );
+            matchingExecutor.execute("matching-test", () -> {
+                throw new IllegalStateException("private-event-payload");
+            });
+            lessonExecutor.execute("lesson-test", nextCallbacks::incrementAndGet);
+
+            assertThat(nextCallbacks).hasValue(0);
+        });
+
+        assertThat(jdbcTemplate.queryForObject(
+                "SELECT COUNT(*) FROM realtime_after_commit_probe WHERE id = 3",
+                Integer.class
+        )).isEqualTo(1);
+        assertThat(nextCallbacks).hasValue(1);
+    }
+
+    private static class RollbackProbeException extends RuntimeException {
+    }
+}
