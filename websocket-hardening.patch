+import org.springframework.transaction.annotation.Propagation;
+import org.springframework.transaction.annotation.Transactional;
+
+@Service
+@RequiredArgsConstructor
+public class MatchingSearchClaimService {
+
+    private final MatchingSearchClaimRepository matchingSearchClaimRepository;
+    private final MatchingSearchSchedulerProperties properties;
+
+    // 요청별 실제 탐색 트랜잭션과 분리해 row lock을 짧게 잡고 배치 진행 위치만 먼저 저장한다.
+    @Transactional(
+            propagation = Propagation.REQUIRES_NEW,
+            isolation = Isolation.READ_COMMITTED
+    )
+    public List<Long> claimDueRequests() {
+        return matchingSearchClaimRepository.claimDueRequestIds(
+                properties.batchSize(),
+                properties.claimLease()
+        );
+    }
+}
