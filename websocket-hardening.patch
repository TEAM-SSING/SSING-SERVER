+
+@Testcontainers(disabledWithoutDocker = true)
+class MatchingSearchSchedulerManualMigrationMySqlIntegrationTest {
+
+    private static final String FORWARD_SCRIPT =
+            "db/manual/2026-07-12-matching-search-scheduler-forward.sql";
+    private static final String ROLLBACK_SCRIPT =
+            "db/manual/2026-07-12-matching-search-scheduler-rollback.sql";
+
+    @Container
+    private static final MySQLContainer<?> MYSQL = new MySQLContainer<>("mysql:8.4.8");
+
+    private static DataSource dataSource;
+    private static JdbcTemplate jdbcTemplate;
+
+    @BeforeAll
+    static void setUpDatabase() {
+        dataSource = new DriverManagerDataSource(
+                MYSQL.getJdbcUrl(),
+                MYSQL.getUsername(),
+                MYSQL.getPassword()
+        );
+        jdbcTemplate = new JdbcTemplate(dataSource);
+    }
+
+    @BeforeEach
+    void resetSchema() {
+        jdbcTemplate.execute("DROP TABLE IF EXISTS matching_scheduler_lock");
+        jdbcTemplate.execute("DROP TABLE IF EXISTS matching_requests");
+        jdbcTemplate.execute("""
+                CREATE TABLE matching_requests (
+                    id BIGINT NOT NULL AUTO_INCREMENT,
+                    status VARCHAR(40) NOT NULL,
+                    created_at DATETIME(6) NOT NULL,
+                    PRIMARY KEY (id)
+                )
+                """);
+    }
+
+    @Test
+    void forward와_rollback_SQL이_실제_MySQL에서_스키마를_순서대로_적용하고_되돌린다() throws SQLException {
+        jdbcTemplate.update("""
+                INSERT INTO matching_requests(id, status, created_at)
+                VALUES (1, 'REQUESTED', '2026-07-01 01:02:03.123456')
+                """);
+
+        executeScript(FORWARD_SCRIPT);
+
+        assertThat(columnCount("matching_requests", "next_search_at")).isOne();
+        assertThat(columnCount("matching_requests", "search_due_at")).isOne();
+        assertThat(generatedColumnExtra("matching_requests", "search_due_at"))
+                .contains("VIRTUAL GENERATED");
+        assertThat(indexColumns("matching_requests", "idx_matching_requests_search_due"))
+                .isEqualTo("status,search_due_at,id");
+        assertThat(tableCount("matching_scheduler_lock")).isOne();
+        assertThat(searchDueAt(1L)).isEqualTo("2026-07-01 01:02:03.123456");
+
+        jdbcTemplate.update("""
+                UPDATE matching_requests
+                SET next_search_at = '2026-07-02 04:05:06.654321'
+                WHERE id = 1
+                """);
+        assertThat(searchDueAt(1L)).isEqualTo("2026-07-02 04:05:06.654321");
+
+        executeScript(ROLLBACK_SCRIPT);
+
+        assertThat(tableCount("matching_scheduler_lock")).isZero();
+        assertThat(indexCount("matching_requests", "idx_matching_requests_search_due")).isZero();
+        assertThat(columnCount("matching_requests", "search_due_at")).isZero();
+        assertThat(columnCount("matching_requests", "next_search_at")).isZero();
+    }
+
+    private static void executeScript(String classpathLocation) throws SQLException {
+        try (Connection connection = dataSource.getConnection()) {
+            ScriptUtils.executeSqlScript(connection, new ClassPathResource(classpathLocation));
+        }
+    }
+
+    private static int columnCount(String tableName, String columnName) {
+        return jdbcTemplate.queryForObject("""
+                SELECT COUNT(*)
+                FROM information_schema.columns
+                WHERE table_schema = DATABASE()
+                  AND table_name = ?
+                  AND column_name = ?
+                """, Integer.class, tableName, columnName);
+    }
+
+    private static int tableCount(String tableName) {
+        return jdbcTemplate.queryForObject("""
+                SELECT COUNT(*)
+                FROM information_schema.tables
+                WHERE table_schema = DATABASE()
+                  AND table_name = ?
+                """, Integer.class, tableName);
+    }
+
+    private static String generatedColumnExtra(String tableName, String columnName) {
+        return jdbcTemplate.queryForObject("""
+                SELECT extra
+                FROM information_schema.columns
+                WHERE table_schema = DATABASE()
+                  AND table_name = ?
+                  AND column_name = ?
+                """, String.class, tableName, columnName);
+    }
+
+    private static String searchDueAt(Long id) {
+        return jdbcTemplate.queryForObject("""
+                SELECT DATE_FORMAT(search_due_at, '%Y-%m-%d %H:%i:%s.%f')
+                FROM matching_requests
+                WHERE id = ?
+                """, String.class, id);
+    }
+
+    private static int indexCount(String tableName, String indexName) {
+        return jdbcTemplate.queryForObject("""
+                SELECT COUNT(*)
+                FROM information_schema.statistics
+                WHERE table_schema = DATABASE()
+                  AND table_name = ?
+                  AND index_name = ?
+                """, Integer.class, tableName, indexName);
+    }
+
+    private static String indexColumns(String tableName, String indexName) {
+        return jdbcTemplate.queryForObject("""
+                SELECT GROUP_CONCAT(column_name ORDER BY seq_in_index SEPARATOR ',')
+                FROM information_schema.statistics
+                WHERE table_schema = DATABASE()
+                  AND table_name = ?
+                  AND index_name = ?
+                """, String.class, tableName, indexName);
+    }
+}
