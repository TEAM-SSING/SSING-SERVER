@@ -0,0 +1,268 @@
+package org.sopt.ssingserver.domain.lesson.realtime;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import java.time.Instant;
+import java.time.OffsetDateTime;
+import java.util.ArrayList;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.UUID;
+import org.junit.jupiter.api.Test;
+import org.sopt.ssingserver.domain.lesson.dto.realtime.LessonRealtimeEvent;
+import org.sopt.ssingserver.domain.lesson.dto.realtime.LessonRealtimeEvent.StartConfirmationUpdatedPayload;
+import org.sopt.ssingserver.domain.lesson.dto.realtime.LessonRealtimeEventType;
+import org.sopt.ssingserver.domain.lesson.dto.realtime.LessonRealtimeRecipientRole;
+import org.sopt.ssingserver.domain.lesson.enums.LessonStatus;
+import org.sopt.ssingserver.domain.lesson.realtime.LessonRealtimeEventFactory.CanceledRealtimeContext;
+import org.sopt.ssingserver.domain.lesson.realtime.LessonRealtimeEventFactory.CompletedRealtimeContext;
+import org.sopt.ssingserver.domain.lesson.realtime.LessonRealtimeEventFactory.ConsumerRecipient;
+import org.sopt.ssingserver.domain.lesson.realtime.LessonRealtimeEventFactory.StartConfirmationRealtimeContext;
+import org.sopt.ssingserver.domain.lesson.realtime.LessonRealtimeEventFactory.StartedRealtimeContext;
+
+class LessonRealtimeEventFactoryTest {
+
+    private static final UUID EVENT_ID = UUID.fromString("00000000-0000-0000-0000-000000000001");
+    private static final Instant OCCURRED_AT = Instant.parse("2026-07-11T00:00:00Z");
+    private static final OffsetDateTime SEOUL_OCCURRED_AT = OffsetDateTime.parse("2026-07-11T09:00:00+09:00");
+    private static final Long LESSON_ID = 100L;
+    private static final Long INSTRUCTOR_MEMBER_ID = 200L;
+    private static final Long CONFIRMED_CONSUMER_MEMBER_ID = 300L;
+    private static final Long UNCONFIRMED_CONSUMER_MEMBER_ID = 301L;
+    private static final Long CONFIRMED_MATCHING_REQUEST_ID = 400L;
+    private static final Long UNCONFIRMED_MATCHING_REQUEST_ID = 401L;
+
+    private final LessonRealtimeEventFactory factory = new LessonRealtimeEventFactory();
+
+    @Test
+    void realtime_context는_transaction안에서_복사한_scalar_snapshot을_유지한다() {
+        List<ConsumerRecipient> recipients = new ArrayList<>(consumerRecipients());
+        Set<Long> confirmedRequestIds = new LinkedHashSet<>(Set.of(CONFIRMED_MATCHING_REQUEST_ID));
+        StartConfirmationRealtimeContext context = new StartConfirmationRealtimeContext(
+                EVENT_ID,
+                OCCURRED_AT,
+                LESSON_ID,
+                INSTRUCTOR_MEMBER_ID,
+                recipients,
+                3,
+                4,
+                true,
+                confirmedRequestIds
+        );
+
+        recipients.clear();
+        confirmedRequestIds.clear();
+
+        assertThat(context.consumerRecipients()).hasSize(2);
+        assertThat(context.confirmedMatchingRequestIds()).containsExactly(CONFIRMED_MATCHING_REQUEST_ID);
+        assertThatThrownBy(() -> context.consumerRecipients().add(consumerRecipient(999L, 999L)))
+                .isInstanceOf(UnsupportedOperationException.class);
+    }
+
+    @Test
+    void startConfirmationUpdated는_수신자별_강습ID와_역할과_현재확인여부를_구성한다() {
+        List<LessonRealtimeDelivery> deliveries = factory.startConfirmationUpdated(
+                new StartConfirmationRealtimeContext(
+                        EVENT_ID,
+                        OCCURRED_AT,
+                        LESSON_ID,
+                        INSTRUCTOR_MEMBER_ID,
+                        consumerRecipients(),
+                        3,
+                        4,
+                        true,
+                        Set.of(CONFIRMED_MATCHING_REQUEST_ID)
+                )
+        );
+
+        assertThat(deliveries).hasSize(3);
+        assertStartConfirmationDelivery(
+                deliveryTo(deliveries, INSTRUCTOR_MEMBER_ID),
+                LessonRealtimeRecipientRole.INSTRUCTOR,
+                true
+        );
+        assertStartConfirmationDelivery(
+                deliveryTo(deliveries, CONFIRMED_CONSUMER_MEMBER_ID),
+                LessonRealtimeRecipientRole.CONSUMER,
+                true
+        );
+        assertStartConfirmationDelivery(
+                deliveryTo(deliveries, UNCONFIRMED_CONSUMER_MEMBER_ID),
+                LessonRealtimeRecipientRole.CONSUMER,
+                false
+        );
+    }
+
+    @Test
+    void startConfirmationUpdated는_동일_member를_한번만_전송한다() {
+        List<LessonRealtimeDelivery> deliveries = factory.startConfirmationUpdated(
+                new StartConfirmationRealtimeContext(
+                        EVENT_ID,
+                        OCCURRED_AT,
+                        LESSON_ID,
+                        INSTRUCTOR_MEMBER_ID,
+                        List.of(
+                                consumerRecipient(INSTRUCTOR_MEMBER_ID, 402L),
+                                consumerRecipient(CONFIRMED_CONSUMER_MEMBER_ID, CONFIRMED_MATCHING_REQUEST_ID),
+                                consumerRecipient(CONFIRMED_CONSUMER_MEMBER_ID, UNCONFIRMED_MATCHING_REQUEST_ID)
+                        ),
+                        1,
+                        2,
+                        true,
+                        Set.of(CONFIRMED_MATCHING_REQUEST_ID)
+                )
+        );
+
+        assertThat(deliveries)
+                .extracting(LessonRealtimeDelivery::recipientMemberId)
+                .containsExactly(INSTRUCTOR_MEMBER_ID, CONFIRMED_CONSUMER_MEMBER_ID)
+                .doesNotHaveDuplicates();
+        StartConfirmationUpdatedPayload consumerPayload = (StartConfirmationUpdatedPayload) deliveryTo(
+                deliveries,
+                CONFIRMED_CONSUMER_MEMBER_ID
+        ).event().payload();
+        assertThat(consumerPayload.currentActorConfirmed()).isTrue();
+    }
+
+    @Test
+    void started는_모든_수신자에게_강습ID와_진행중_상태와_빈_payload를_구성한다() {
+        List<LessonRealtimeDelivery> deliveries = factory.started(new StartedRealtimeContext(
+                EVENT_ID,
+                OCCURRED_AT,
+                LESSON_ID,
+                INSTRUCTOR_MEMBER_ID,
+                consumerRecipients()
+        ));
+
+        assertStatusDeliveries(
+                deliveries,
+                LessonRealtimeEventType.LESSON_STARTED,
+                LessonStatus.IN_PROGRESS
+        );
+    }
+
+    @Test
+    void completed는_모든_수신자에게_강습ID와_완료_상태와_빈_payload를_구성한다() {
+        List<LessonRealtimeDelivery> deliveries = factory.completed(new CompletedRealtimeContext(
+                EVENT_ID,
+                OCCURRED_AT,
+                LESSON_ID,
+                INSTRUCTOR_MEMBER_ID,
+                consumerRecipients()
+        ));
+
+        assertStatusDeliveries(
+                deliveries,
+                LessonRealtimeEventType.LESSON_COMPLETED,
+                LessonStatus.COMPLETED
+        );
+    }
+
+    @Test
+    void canceled는_모든_수신자에게_강습ID와_취소_상태와_빈_payload를_구성한다() {
+        List<LessonRealtimeDelivery> deliveries = factory.canceled(new CanceledRealtimeContext(
+                EVENT_ID,
+                OCCURRED_AT,
+                LESSON_ID,
+                INSTRUCTOR_MEMBER_ID,
+                consumerRecipients()
+        ));
+
+        assertStatusDeliveries(
+                deliveries,
+                LessonRealtimeEventType.LESSON_CANCELED,
+                LessonStatus.CANCELED
+        );
+    }
+
+    @Test
+    void 상태변경은_동일_member를_한번만_전송한다() {
+        List<LessonRealtimeDelivery> deliveries = factory.started(new StartedRealtimeContext(
+                EVENT_ID,
+                OCCURRED_AT,
+                LESSON_ID,
+                INSTRUCTOR_MEMBER_ID,
+                List.of(
+                        consumerRecipient(INSTRUCTOR_MEMBER_ID, 402L),
+                        consumerRecipient(CONFIRMED_CONSUMER_MEMBER_ID, CONFIRMED_MATCHING_REQUEST_ID),
+                        consumerRecipient(CONFIRMED_CONSUMER_MEMBER_ID, UNCONFIRMED_MATCHING_REQUEST_ID)
+                )
+        ));
+
+        assertThat(deliveries)
+                .extracting(LessonRealtimeDelivery::recipientMemberId)
+                .containsExactly(INSTRUCTOR_MEMBER_ID, CONFIRMED_CONSUMER_MEMBER_ID)
+                .doesNotHaveDuplicates();
+    }
+
+    private void assertStartConfirmationDelivery(
+            LessonRealtimeDelivery delivery,
+            LessonRealtimeRecipientRole recipientRole,
+            boolean currentActorConfirmed
+    ) {
+        LessonRealtimeEvent event = delivery.event();
+        assertThat(event.eventId()).isEqualTo(EVENT_ID);
+        assertThat(event.eventType()).isSameAs(LessonRealtimeEventType.LESSON_START_CONFIRMATION_UPDATED);
+        assertThat(event.occurredAt()).isEqualTo(SEOUL_OCCURRED_AT);
+        assertThat(event.recipientRole()).isSameAs(recipientRole);
+        assertThat(event.lessonId()).isEqualTo(LESSON_ID);
+        assertThat(event.lessonStatus()).isSameAs(LessonStatus.CONFIRMED);
+        assertThat(event.payload()).isInstanceOfSatisfying(
+                StartConfirmationUpdatedPayload.class,
+                payload -> {
+                    assertThat(payload.confirmedCount()).isEqualTo(3);
+                    assertThat(payload.requiredCount()).isEqualTo(4);
+                    assertThat(payload.currentActorConfirmed()).isEqualTo(currentActorConfirmed);
+                    assertThat(payload.instructorConfirmed()).isTrue();
+                }
+        );
+    }
+
+    private void assertStatusDeliveries(
+            List<LessonRealtimeDelivery> deliveries,
+            LessonRealtimeEventType eventType,
+            LessonStatus lessonStatus
+    ) {
+        assertThat(deliveries).hasSize(3);
+        assertThat(deliveryTo(deliveries, INSTRUCTOR_MEMBER_ID).event().recipientRole())
+                .isSameAs(LessonRealtimeRecipientRole.INSTRUCTOR);
+        assertThat(deliveryTo(deliveries, CONFIRMED_CONSUMER_MEMBER_ID).event().recipientRole())
+                .isSameAs(LessonRealtimeRecipientRole.CONSUMER);
+        assertThat(deliveryTo(deliveries, UNCONFIRMED_CONSUMER_MEMBER_ID).event().recipientRole())
+                .isSameAs(LessonRealtimeRecipientRole.CONSUMER);
+
+        assertThat(deliveries).allSatisfy(delivery -> {
+            LessonRealtimeEvent event = delivery.event();
+            assertThat(event.eventId()).isEqualTo(EVENT_ID);
+            assertThat(event.eventType()).isSameAs(eventType);
+            assertThat(event.occurredAt()).isEqualTo(SEOUL_OCCURRED_AT);
+            assertThat(event.lessonId()).isEqualTo(LESSON_ID);
+            assertThat(event.lessonStatus()).isSameAs(lessonStatus);
+            assertThat(event.payload()).isEqualTo(Map.of());
+        });
+    }
+
+    private LessonRealtimeDelivery deliveryTo(
+            List<LessonRealtimeDelivery> deliveries,
+            Long recipientMemberId
+    ) {
+        return deliveries.stream()
+                .filter(delivery -> delivery.recipientMemberId().equals(recipientMemberId))
+                .findFirst()
+                .orElseThrow();
+    }
+
+    private List<ConsumerRecipient> consumerRecipients() {
+        return List.of(
+                consumerRecipient(CONFIRMED_CONSUMER_MEMBER_ID, CONFIRMED_MATCHING_REQUEST_ID),
+                consumerRecipient(UNCONFIRMED_CONSUMER_MEMBER_ID, UNCONFIRMED_MATCHING_REQUEST_ID)
+        );
+    }
+
+    private ConsumerRecipient consumerRecipient(Long memberId, Long matchingRequestId) {
+        return new ConsumerRecipient(memberId, matchingRequestId);
+    }
+}
diff --git a/src/test/java/org/sopt/ssingserver/domain/lesson/realtime/LessonRealtimeEventPublisherTest.java b/src/test/java/org/sopt/ssingserver/domain/lesson/realtime/LessonRealtimeEventPublisherTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..2a7a234bd56240d28ca021093ffbf01f708d54cd
--- /dev/null
+++ b/src/test/java/org/sopt/ssingserver/domain/lesson/realtime/LessonRealtimeEventPublisherTest.java
@@ -0,0 +1,98 @@
+package org.sopt.ssingserver.domain.lesson.realtime;
+
+import static org.assertj.core.api.Assertions.assertThatCode;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.anyLong;
+import static org.mockito.ArgumentMatchers.eq;
+import static org.mockito.Mockito.doThrow;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.times;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.verifyNoInteractions;
+
+import java.time.OffsetDateTime;
+import java.time.ZoneOffset;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import org.junit.jupiter.api.Test;
+import org.sopt.ssingserver.domain.lesson.dto.realtime.LessonRealtimeEvent;
+import org.sopt.ssingserver.domain.lesson.dto.realtime.LessonRealtimeEventType;
+import org.sopt.ssingserver.domain.lesson.dto.realtime.LessonRealtimeRecipientRole;
+import org.sopt.ssingserver.domain.lesson.enums.LessonStatus;
+import org.sopt.ssingserver.global.realtime.RealtimeWebSocketObservability;
+
+class LessonRealtimeEventPublisherTest {
+
+    private final LessonRealtimeNotifier notifier = mock(LessonRealtimeNotifier.class);
+    private final RealtimeWebSocketObservability observability = mock(RealtimeWebSocketObservability.class);
+    private final LessonRealtimeEventPublisher publisher = new LessonRealtimeEventPublisher(notifier, observability);
+
+    @Test
+    void publish는_channel_제출_시도와_accepted를_전달성공과_구분해_기록한다() {
+        LessonRealtimeDelivery delivery = delivery(1L);
+
+        publisher.publish(List.of(delivery));
+
+        verify(notifier).send(delivery);
+        verify(observability).publishAttempt(
+                "lesson", delivery.event().eventId(), "LESSON_STARTED", "/queue/lesson"
+        );
+        verify(observability).publishChannelAccepted(
+                eq("lesson"),
+                eq(delivery.event().eventId()),
+                eq("LESSON_STARTED"),
+                eq("/queue/lesson"),
+                anyLong()
+        );
+    }
+
+    @Test
+    void publish는_빈_delivery를_skip으로_기록한다() {
+        publisher.publish(List.of());
+
+        verifyNoInteractions(notifier);
+        verify(observability).publishSkipped("lesson", null, "UNKNOWN", "delivery-empty");
+    }
+
+    @Test
+    void publish는_한_수신자_실패가_다른_수신자_전송을_막지_않는다() {
+        LessonRealtimeDelivery failed = delivery(1L);
+        LessonRealtimeDelivery next = delivery(2L);
+        IllegalStateException exception = new IllegalStateException("private lesson payload");
+        doThrow(exception).when(notifier).send(failed);
+
+        assertThatCode(() -> publisher.publish(List.of(failed, next))).doesNotThrowAnyException();
+
+        verify(notifier, times(2)).send(any(LessonRealtimeDelivery.class));
+        verify(observability).publishFailure(
+                eq("lesson"),
+                eq(failed.event().eventId()),
+                eq("LESSON_STARTED"),
+                eq("/queue/lesson"),
+                eq("delivery-send"),
+                eq(exception),
+                anyLong()
+        );
+        verify(observability).publishChannelAccepted(
+                eq("lesson"),
+                eq(next.event().eventId()),
+                eq("LESSON_STARTED"),
+                eq("/queue/lesson"),
+                anyLong()
+        );
+    }
+
+    private LessonRealtimeDelivery delivery(Long memberId) {
+        LessonRealtimeEvent event = new LessonRealtimeEvent(
+                UUID.randomUUID(),
+                LessonRealtimeEventType.LESSON_STARTED,
